Subject: [PATCH v1 6/6] Rename the relocated sections

---
 include/irq.h           | 2 +-
 include/linboot.h       | 2 +-
 src/haret.lds           | 6 +++---
 src/linboot.cpp         | 2 +-
 src/mach/arch-msm-asm.S | 2 +-
 src/mach/arch-s3.cpp    | 2 +-
 src/wince/asmstuff.S    | 4 ++--
 src/wince/irqchain.S    | 2 +-
 tools/checkrelocs       | 6 +++---
 9 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/include/irq.h b/include/irq.h
index 9862474..a8a88b3 100644
--- a/include/irq.h
+++ b/include/irq.h
@@ -10,7 +10,7 @@
 // Functions marked with this attribute will be relocated to an
 // independant area of memory during interrupt watching.  Code in this
 // section must not reference data or code in any other sections.
-#define __irq __attribute__ ((__section__ (".text.irq")))
+#define __irq __attribute__ ((__section__ (".textirq")))
 
 
 /****************************************************************
diff --git a/include/linboot.h b/include/linboot.h
index 47a6fab..92b29ef 100644
--- a/include/linboot.h
+++ b/include/linboot.h
@@ -6,7 +6,7 @@
 // preloading and are run with the MMU disabled.  These functions must
 // be careful to not call functions that aren't also marked this way.
 // They must also not use any global variables.
-#define __preload __attribute__ ((__section__ (".text.preload")))
+#define __preload __attribute__ ((__section__ (".textpreload")))
 
 void __preload do_copy(char *dest, const char *src, int count);
 
diff --git a/src/haret.lds b/src/haret.lds
index 33687f4..acdd431 100644
--- a/src/haret.lds
+++ b/src/haret.lds
@@ -11,19 +11,19 @@ SECTIONS
      * memory.
      */
     irq_start = .;
-    *(.text.irq)
+    *(.textirq)
     irq_end = .;
 
     /* As above, create two symbols for the preloader code. */
     preload_start = .;
-    *(.text.preload)
+    *(.textpreload)
     preload_end = .;
 
     /* Make sure the trampline is on one page (if it would span to a
      * second page, align it to the start of a page). */
     . = ((. + mmu_trampoline_end - mmu_trampoline) > ALIGN(4096))
          ? ALIGN(4096) : .;
-    *(.text.trampoline)
+    *(.texttrampoline)
   }
   .rdata : {
     /* Create two symbols around the list of machine init functions. */
diff --git a/src/linboot.cpp b/src/linboot.cpp
index 28bc9b1..158a4e8 100644
--- a/src/linboot.cpp
+++ b/src/linboot.cpp
@@ -244,7 +244,7 @@ static inline uint32 __preload do_cpuGetPSR(void) {
     __str;                                      \
 })
 
-#define FB_PRINTF(fbi,fmt,args...) fb_printf((fbi), STR_IN_CODE(.text.preload, fmt) , ##args )
+#define FB_PRINTF(fbi,fmt,args...) fb_printf((fbi), STR_IN_CODE(.textpreload, fmt) , ##args )
 
 static inline int __preload
 fbOverlaps(struct preloadData *pd)
diff --git a/src/mach/arch-msm-asm.S b/src/mach/arch-msm-asm.S
index da534a0..e0f2487 100644
--- a/src/mach/arch-msm-asm.S
+++ b/src/mach/arch-msm-asm.S
@@ -41,7 +41,7 @@
 #define DSB .byte 0x4f, 0xf0, 0x7f, 0xf5
 #define ISB .byte 0x6f, 0xf0, 0x7f, 0xf5
 
-.section .text.preload
+.section .textpreload
 	.global bootQSD8xxx
 bootQSD8xxx:
 
diff --git a/src/mach/arch-s3.cpp b/src/mach/arch-s3.cpp
index 98906b2..2b3dffd 100644
--- a/src/mach/arch-s3.cpp
+++ b/src/mach/arch-s3.cpp
@@ -130,7 +130,7 @@ REGMACHINE(MachineS3c2442)
  * S3c64x0 - Tanguy Pruvot on Gmail
