-//#define FB_PRINTF(fbi,fmt,args...) fb_printf((fbi), STR_IN_CODE(.text.preload, fmt) , ##args )
+//#define FB_PRINTF(fbi,fmt,args...) fb_printf((fbi), STR_IN_CODE(.textpreload, fmt) , ##args )
 
 MachineS3c6400::MachineS3c6400()
 {
diff --git a/src/wince/asmstuff.S b/src/wince/asmstuff.S
index 076c6ae..64e70ea 100644
--- a/src/wince/asmstuff.S
+++ b/src/wince/asmstuff.S
@@ -124,7 +124,7 @@ cpuFlushCache_arm6:
 
 @ Assembler stub that (when relocated) can store the location of a
 @ stack and C executable function to jump to.
-        .section .text.preload
+        .section .textpreload
         .global stackJumper
 stackJumper:
 stack:          .long 0
@@ -142,7 +142,7 @@ asm_handler:
 @       r1 = Virtual address of MMU in non-cached ram.
 @       r2 = Physical address of code to jump to
 @       r3 = cpu flush cache function
-        .section .text.trampoline
+        .section .texttrampoline
         .global mmu_trampoline, mmu_trampoline_end
 mmu_trampoline:
 	@ Store previous registers on stack.
diff --git a/src/wince/irqchain.S b/src/wince/irqchain.S
index 8993d33..5bd3f57 100644
--- a/src/wince/irqchain.S
+++ b/src/wince/irqchain.S
@@ -4,7 +4,7 @@
 @
 @ This file may be distributed under the terms of the GNU GPL license.
 
-        .section .text.irq
+        .section .textirq
 
 @ This handler is copied to a malloc'd memory area in the irq.c C
 @ code.  The following variables are designed to overlap with the
diff --git a/tools/checkrelocs b/tools/checkrelocs
index e1f8aca..862b3fb 100755
--- a/tools/checkrelocs
+++ b/tools/checkrelocs
@@ -3,7 +3,7 @@
 # Usage: checkrelocs <objs.o> [...]
 
 # This script checks for any outstanding relocations in the
-# .text.preload and .text.irq sections.  Since these sections are
+# .textpreload and .textirq sections.  Since these sections are
 # moved to new areas in memory during the haret runtime, the code can
 # not reliably access other parts of the haret system.  (Having an
 # external relocation will result in a mysterious runtime error.)
@@ -14,7 +14,7 @@ TMP=tmp_link.o
 IGNORE=" ARM_26D | ARM_32[ ]*\.text[+-]"
 
 $LD -r "$@" -o $TMP
-$OBJDUMP -C -r -j .text.preload -j .text.irq $TMP | egrep -v "$IGNORE" | grep -q '^0'
+$OBJDUMP -C -r -j .textpreload -j .textirq $TMP | egrep -v "$IGNORE" | grep -q '^0'
 STATUS=$?
 
 if [ $STATUS != 0 ]; then
@@ -26,7 +26,7 @@ echo "ERROR:"
 echo "ERROR: There is an external reference from a standalone haret section."
 echo "ERROR:"
 
-$OBJDUMP -C -r -j .text.preload -j .text.irq $TMP | egrep -v "$IGNORE"
+$OBJDUMP -C -r -j .textpreload -j .textirq $TMP | egrep -v "$IGNORE"
 rm -f $TMP
 
 exit 1
