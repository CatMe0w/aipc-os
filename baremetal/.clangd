CompileFlags:
  Compiler: arm-none-eabi-gcc
  Add:
    - --target=arm-none-eabi
    - -mcpu=arm926ej-s
    - -marm
    - -std=gnu11
    - -ffreestanding
    - -Wall
    - -Wextra
    - -Wno-unused-parameter
Diagnostics:
  Includes:
    IgnoreHeader:
      - lvgl\.h

---
If:
  PathMatch: aipc-boot/.*
CompileFlags:
  Add:
    - -I.
    - -I../lib
    - -I../nkpf
    - -Ithird_party
    - -DLV_CONF_INCLUDE_SIMPLE
    - -DLOG_BASE=0x301B0000u

---
If:
  PathMatch: doom/src/.*
CompileFlags:
  Add:
    - -I../../lib
    - -I../doomgeneric/doomgeneric
    - -DLOG_BASE=0x301A0000u
    - -DDOOMGENERIC_RESX=320
    - -DDOOMGENERIC_RESY=200
    - -DWAD_FILENAME="doom1.wad"

---
If:
  PathMatch: opennboot/.*
CompileFlags:
  Add:
    - -I.
    - -I../lib

---
# test/ builds on the host, one directory deeper.
If:
  PathMatch: opennboot/test/.*
CompileFlags:
  Add:
    - -I../../lib

---
# sd_pio.c stops at an #error until the variant is selected.
If:
  PathMatch: probes/sd/.*
CompileFlags:
  Add:
    - -DPIO_WITHDATA=1

---
# clangd analyses a header on its own as Objective-C++. These are C headers.
If:
  PathMatch: .*\.h
CompileFlags:
  Add:
    - -xc-header

---
# cpufreq/payload/ uses headers from cpufreq/stub/
If:
  PathMatch: probes/cpufreq/payload/.*
CompileFlags:
  Add:
    - -I.
    - -I../stub
    - -I../../../gdbstub

---
# Frozen one-time probe code
If:
  PathMatch: probes/.*
Diagnostics:
  UnusedIncludes: None

---
# nkpf
If:
  PathMatch: nkpf/[^/]*
CompileFlags:
  Add:
    - -I.
    - -I../lib
    - -DNKPF_DIAG
    - -DLOG_BASE=0x30180000u
    - -DLOG_NO_UART

---
If:
  PathMatch: nkpf/resident/.*
CompileFlags:
  Add:
    - -I.
    - -I..
    - -I../../lib
    - -DNKPF_DIAG
