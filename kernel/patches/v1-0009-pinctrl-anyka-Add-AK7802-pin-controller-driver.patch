+	{ ANYKA_SHAREPIN_CON1, BIT(29), BIT(29) },
+};
+
+static const struct anyka_pmx_reg sdio_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, GENMASK(15, 14), GENMASK(15, 14) },
+	{ ANYKA_SHAREPIN_CON2, GENMASK(2, 1), BIT(2) },
+};
+
+static const struct anyka_pmx_reg spi1_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, BIT(30) | GENMASK(2, 1) | BIT(4),
+	  BIT(30) | BIT(4) },
+};
+
+static const struct anyka_pin_group anyka_groups[] = {
+	{ "lcd", lcd_pins, ARRAY_SIZE(lcd_pins), lcd_regs, ARRAY_SIZE(lcd_regs) },
+	{ "nand", nand_pins, ARRAY_SIZE(nand_pins), nand_regs, ARRAY_SIZE(nand_regs) },
+	{ "sdmmc1", sdmmc1_pins, ARRAY_SIZE(sdmmc1_pins), sdmmc1_regs, ARRAY_SIZE(sdmmc1_regs) },
+	{ "sdmmc2", sdmmc2_pins, ARRAY_SIZE(sdmmc2_pins), sdmmc2_regs, ARRAY_SIZE(sdmmc2_regs) },
+	{ "sdio", sdio_pins, ARRAY_SIZE(sdio_pins), sdio_regs, ARRAY_SIZE(sdio_regs) },
+	{ "spi1", spi1_pins, ARRAY_SIZE(spi1_pins), spi1_regs, ARRAY_SIZE(spi1_regs) },
+};
+
+static const char * const lcd_groups[] = { "lcd" };
+static const char * const nand_groups[] = { "nand" };
+static const char * const sdmmc_groups[] = { "sdmmc1", "sdmmc2" };
+static const char * const sdio_groups[] = { "sdio" };
+static const char * const spi1_groups[] = { "spi1" };
+
+static const struct anyka_pmx_func anyka_functions[] = {
+	{ "lcd", lcd_groups, ARRAY_SIZE(lcd_groups) },
+	{ "nand", nand_groups, ARRAY_SIZE(nand_groups) },
+	{ "sdmmc", sdmmc_groups, ARRAY_SIZE(sdmmc_groups) },
+	{ "sdio", sdio_groups, ARRAY_SIZE(sdio_groups) },
+	{ "spi1", spi1_groups, ARRAY_SIZE(spi1_groups) },
+};
+
+static int anyka_pinctrl_set_mux(struct pinctrl_dev *pctldev,
+				 unsigned int func_selector,
+				 unsigned int group_selector)
+{
+	struct anyka_pinctrl *ap = pinctrl_dev_get_drvdata(pctldev);
+	const struct anyka_pin_group *group;
+	struct group_desc *desc;
+	unsigned int i;
+	int ret = 0;
+
+	desc = pinctrl_generic_get_group(pctldev, group_selector);
+	if (!desc)
+		return -EINVAL;
+
+	group = desc->data;
+
+	mutex_lock(&ap->lock);
+	for (i = 0; i < group->nregs; i++) {
+		const struct anyka_pmx_reg *reg = &group->regs[i];
+
+		ret = regmap_update_bits(ap->syscon, reg->offset,
+					 reg->mask, reg->value);
+		if (ret)
+			break;
+	}
+	mutex_unlock(&ap->lock);
+
+	return ret;
+}
+
+static const struct pinmux_ops anyka_pinmux_ops = {
+	.get_functions_count = pinmux_generic_get_function_count,
+	.get_function_name = pinmux_generic_get_function_name,
+	.get_function_groups = pinmux_generic_get_function_groups,
+	.set_mux = anyka_pinctrl_set_mux,
+};
+
+static const struct pinctrl_ops anyka_pinctrl_ops = {
+	.get_groups_count = pinctrl_generic_get_group_count,
+	.get_group_name = pinctrl_generic_get_group_name,
+	.get_group_pins = pinctrl_generic_get_group_pins,
+	.dt_node_to_map = pinconf_generic_dt_node_to_map_group,
+	.dt_free_map = pinconf_generic_dt_free_map,
+};
+
+static int anyka_pinconf_group_set(struct pinctrl_dev *pctldev,
+				   unsigned int group_selector,
+				   unsigned long *configs,
+				   unsigned int num_configs)
+{
+	struct anyka_pinctrl *ap = pinctrl_dev_get_drvdata(pctldev);
+	struct group_desc *desc;
+	enum pin_config_param param;
+	const char *name;
+	unsigned int i;
+	int ret = 0;
+
+	desc = pinctrl_generic_get_group(pctldev, group_selector);
+	if (!desc)
+		return -EINVAL;
+	name = desc->grp.name;
+
+	mutex_lock(&ap->lock);
+	for (i = 0; i < num_configs; i++) {
+		param = pinconf_to_config_param(configs[i]);
+
+		switch (param) {
+		case PIN_CONFIG_BIAS_DISABLE:
+			if (!strcmp(name, "spi1"))
+				ret = regmap_update_bits(ap->syscon,
+							 ANYKA_PULLDOWN3,
+							 GENMASK(15, 12),
+							 GENMASK(15, 12));
+			else
+				ret = -EOPNOTSUPP;
+			break;
+		case PIN_CONFIG_BIAS_PULL_UP:
+			if (!strcmp(name, "sdmmc1") || !strcmp(name, "sdmmc2"))
+				ret = regmap_update_bits(ap->syscon,
+							 ANYKA_PULLDOWN2,
+							 GENMASK(8, 7),
+							 GENMASK(8, 7));
+			else if (!strcmp(name, "sdio"))
+				ret = regmap_update_bits(ap->syscon,
+							 ANYKA_PULLDOWN1,
+							 GENMASK(29, 26),
+							 GENMASK(29, 26));
+			else
+				ret = -EOPNOTSUPP;
+			break;
+		default:
+			ret = -EOPNOTSUPP;
+			break;
+		}
+
+		if (ret)
+			break;
+	}
+	mutex_unlock(&ap->lock);
+
+	return ret;
+}
+
+static const struct pinconf_ops anyka_pinconf_ops = {
+	.pin_config_group_set = anyka_pinconf_group_set,
+	.is_generic = true,
+};
+
+static int anyka_pinctrl_probe(struct platform_device *pdev)
+{
+	struct anyka_pinctrl *ap;
+	unsigned int i;
+	int ret;
+
+	ap = devm_kzalloc(&pdev->dev, sizeof(*ap), GFP_KERNEL);
+	if (!ap)
+		return -ENOMEM;
+
+	ap->dev = &pdev->dev;
+	mutex_init(&ap->lock);
+
+	ap->syscon = syscon_regmap_lookup_by_phandle(pdev->dev.of_node,
+						     "syscon");
+	if (IS_ERR(ap->syscon))
+		return dev_err_probe(&pdev->dev, PTR_ERR(ap->syscon),
+				     "failed to get syscon\n");
+
+	ap->desc.name = "anyka-pinctrl";
+	ap->desc.owner = THIS_MODULE;
+	ap->desc.pins = anyka_pins;
+	ap->desc.npins = ARRAY_SIZE(anyka_pins);
+	ap->desc.pctlops = &anyka_pinctrl_ops;
+	ap->desc.pmxops = &anyka_pinmux_ops;
+	ap->desc.confops = &anyka_pinconf_ops;
+
+	ap->pctldev = devm_pinctrl_register(&pdev->dev, &ap->desc, ap);
+	if (IS_ERR(ap->pctldev))
+		return dev_err_probe(&pdev->dev, PTR_ERR(ap->pctldev),
+				     "failed to register pinctrl\n");
+
+	for (i = 0; i < ARRAY_SIZE(anyka_groups); i++) {
+		const struct anyka_pin_group *group = &anyka_groups[i];
+
+		ret = pinctrl_generic_add_group(ap->pctldev, group->name,
+						group->pins, group->npins,
+						(void *)group);
+		if (ret < 0)
+			return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(anyka_functions); i++) {
+		const struct anyka_pmx_func *func = &anyka_functions[i];
+
+		ret = pinmux_generic_add_function(ap->pctldev, func->name,
+						  func->groups, func->ngroups,
+						  NULL);
+		if (ret < 0)
+			return ret;
+	}
+
+	dev_info(&pdev->dev, "registered %u pins\n", ANYKA_PINCTRL_PINS);
+
+	return 0;
+}
+
+static const struct of_device_id anyka_pinctrl_of_match[] = {
+	{ .compatible = "anyka,ak7802-pinctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, anyka_pinctrl_of_match);
+
+static struct platform_driver anyka_pinctrl_driver = {
+	.probe = anyka_pinctrl_probe,
+	.driver = {
+		.name = "anyka-pinctrl",
+		.of_match_table = anyka_pinctrl_of_match,
+	},
+};
+module_platform_driver(anyka_pinctrl_driver);
+
+MODULE_DESCRIPTION("Anyka AK78/AK88/AK98 pin controller");
+MODULE_LICENSE("GPL");
diff --git a/drivers/spi/spi-ak88.c b/drivers/spi/spi-ak88.c
index 8dc61e4cc..7778b240c 100644
--- a/drivers/spi/spi-ak88.c
+++ b/drivers/spi/spi-ak88.c
@@ -50,9 +50,6 @@
 #define AK88_SHAREPIN_CON1		0x78
 #define AK88_SHAREPIN_SPI_CLK		BIT(30)
 #define AK88_SHAREPIN_SPI_DATA		GENMASK(2, 1)
-#define AK88_SHAREPIN_WLED_PWM		BIT(4)
-#define AK88_PPU_PPD3			0xa4
-#define AK88_SPI0_GPIO_MASK		GENMASK(15, 12)
 
 #define AK88_DEFAULT_INPUT_CLOCK_HZ	248000000
 #define AK88_SPICON_CLKDIV_MASK		(0x7f << 8)
@@ -76,35 +73,6 @@ static int ak88_spi_enable_clock(struct ak88_spi *hw)
 				  AK88_CLOCK_CTRL_SPI, 0);
 }
 
-static int ak88_spi_config_pins(struct ak88_spi *hw)
-{
-	u32 mask = AK88_SHAREPIN_SPI_CLK | AK88_SHAREPIN_SPI_DATA |
-		   AK88_SHAREPIN_WLED_PWM;
-	int ret;
-
-	/*
-	 * AK7802 routes this controller with bit30 set, bit4 set, and bits 1:2
-	 * cleared in SHAREPIN_CON1. GPIO chip-select muxing is handled by the
