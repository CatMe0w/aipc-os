+static const unsigned int sdmmc1_pins[] = { 30, 31, 32, 33, 34, 35, 36, 37 };
+static const unsigned int sdmmc2_pins[] = { 72, 73, 74, 75 };
+static const unsigned int sdio_pins[] = { 14, 15, 16, 17, 28, 29 };
+static const unsigned int spi1_pins[] = { 76, 77, 78, 79 };
+
+static const struct anyka_pmx_reg lcd_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, GENMASK(28, 25), GENMASK(28, 25) },
+};
+
+static const struct anyka_pmx_reg nand_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, GENMASK(19, 16) | BIT(22),
+	  GENMASK(19, 16) | BIT(22) },
+	{ ANYKA_SHAREPIN_CON2, GENMASK(4, 3), BIT(3) },
+};
+
+static const struct anyka_pmx_reg sdmmc1_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, GENMASK(18, 16), GENMASK(18, 16) },
+	{ ANYKA_SHAREPIN_CON2, GENMASK(4, 3), BIT(4) },
+};
+
