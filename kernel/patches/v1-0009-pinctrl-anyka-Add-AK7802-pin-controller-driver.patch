+struct anyka_pmx_reg {
+	u32 offset;
+	u32 mask;
+	u32 value;
+};
+
+struct anyka_pin_group {
+	const char *name;
+	const unsigned int *pins;
+	unsigned int npins;
+	const struct anyka_pmx_reg *regs;
+	unsigned int nregs;
+};
+
+struct anyka_pmx_func {
+	const char *name;
+	const char * const *groups;
+	unsigned int ngroups;
+};
+
+struct anyka_pinctrl {
+	struct device *dev;
+	struct regmap *syscon;
+	struct pinctrl_dev *pctldev;
+	struct pinctrl_desc desc;
+	struct mutex lock;
+};
