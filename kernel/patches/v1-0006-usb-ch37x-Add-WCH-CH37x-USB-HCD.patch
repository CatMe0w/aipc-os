Date: Fri, 1 May 2026 10:42:24 +0800
Subject: [PATCH v1 06/12] usb: ch37x: Add WCH CH37x USB HCD

---
 drivers/usb/host/Kconfig     |   10 +
 drivers/usb/host/Makefile    |    1 +
 drivers/usb/host/ch37x-hcd.c | 2609 ++++++++++++++++++++++++++++++++++
 drivers/usb/host/ch37x.h     |  168 +++
 4 files changed, 2788 insertions(+)
 create mode 100644 drivers/usb/host/ch37x-hcd.c
 create mode 100644 drivers/usb/host/ch37x.h

diff --git a/drivers/usb/host/Kconfig b/drivers/usb/host/Kconfig
index 0a277a07c..d1f397ec4 100644
--- a/drivers/usb/host/Kconfig
+++ b/drivers/usb/host/Kconfig
@@ -4,6 +4,16 @@
 #
 comment "USB Host Controller Drivers"
 
+config USB_CH37X_HCD
+	tristate "WCH CH37x SPI USB host controller"
+	depends on USB && SPI
+	help
+	  This enables the WCH CH370/CH374 USB host controller driver over
+	  SPI. It registers as a Linux USB HCD.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called ch37x-hcd.
+
 config USB_C67X00_HCD
 	tristate "Cypress C67x00 HCD support"
 	depends on HAS_IOMEM
diff --git a/drivers/usb/host/Makefile b/drivers/usb/host/Makefile
index a07e7ba9c..2e856c3b8 100644
--- a/drivers/usb/host/Makefile
+++ b/drivers/usb/host/Makefile
@@ -37,6 +37,7 @@ ifneq ($(CONFIG_USB_XHCI_SIDEBAND),)
 endif
 
 obj-$(CONFIG_USB_PCI)	+= pci-quirks.o
+obj-$(CONFIG_USB_CH37X_HCD)	+= ch37x-hcd.o
 
 obj-$(CONFIG_USB_EHCI_HCD)	+= ehci-hcd.o
 obj-$(CONFIG_USB_EHCI_PCI)	+= ehci-pci.o
