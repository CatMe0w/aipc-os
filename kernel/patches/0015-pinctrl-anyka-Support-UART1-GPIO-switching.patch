From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CatMe0w <CatMe0w@live.cn>
Date: Mon, 7 Sep 2026 20:22:02 -0600
Subject: [PATCH] pinctrl: anyka: Support UART1 GPIO switching

---
 drivers/gpio/Kconfig            |  1 +
 drivers/gpio/gpio-anyka.c       | 44 ++++++++++++++++-----------------
 drivers/pinctrl/pinctrl-anyka.c | 17 +++++++++++++
 3 files changed, 40 insertions(+), 22 deletions(-)

diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index f5e6922b4..d6dc89c7f 100644
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -183,6 +183,7 @@ config GPIO_ANYKA
 	bool "Anyka AK78/AK88/AK98 GPIO support"
 	depends on ARCH_ANYKA || COMPILE_TEST
 	select GPIOLIB_IRQCHIP
+	select MFD_SYSCON
 	help
 	  Say Y here to support the internal GPIO controller found in
 	  Anyka AK78/AK88/AK98 ARM926 SoCs.
diff --git a/drivers/gpio/gpio-anyka.c b/drivers/gpio/gpio-anyka.c
index 76a6fce3a..03957780c 100644
--- a/drivers/gpio/gpio-anyka.c
+++ b/drivers/gpio/gpio-anyka.c
@@ -15,6 +15,8 @@
 #include <linux/irqchip/chained_irq.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
 #include <linux/of_device.h>
 #include <linux/pinctrl/pinconf-generic.h>
 #include <linux/platform_device.h>
@@ -59,6 +61,8 @@ static const struct anyka_sharepin_range anyka_sharepin_set_con2[] = {
 };
 
 struct anyka_gpio {
+	struct regmap *sysctrl;
+	bool ak7802;
 	void __iomem *base;
 	spinlock_t lock;
 	struct gpio_chip gc;
@@ -131,50 +135,40 @@ static u32 anyka_gpio_group_mask(struct gpio_chip *gc, unsigned int group)
 
 static void anyka_gpio_force_mux(struct anyka_gpio *ag, unsigned int offset)
 {
-	unsigned long flags;
 	unsigned int i;
 
-	spin_lock_irqsave(&ag->lock, flags);
-
-	if (offset == 28 || offset == 29) {
-		u32 val = readl_relaxed(ag->base + ANYKA_GPIO_SHAREPIN_CON2);
-
-		val &= ~(GENMASK(2, 1));
-		writel_relaxed(val, ag->base + ANYKA_GPIO_SHAREPIN_CON2);
+	/* Share the syscon lock with pinctrl during UART/GPIO changes. */
+	if (ag->ak7802 && (offset == 14 || offset == 15)) {
+		regmap_update_bits(ag->sysctrl, 0x78, BIT(9), 0);
+		return;
 	}
+	if (offset == 28 || offset == 29)
+		regmap_update_bits(ag->sysctrl, 0x74, GENMASK(2, 1), 0);
 
 	for (i = 0; i < ARRAY_SIZE(anyka_sharepin_clr_con1); i++) {
 		const struct anyka_sharepin_range *range = &anyka_sharepin_clr_con1[i];
 
 		if (offset >= range->start && offset <= range->end) {
-			anyka_gpio_update_bit(ag->base + ANYKA_GPIO_SHAREPIN_CON1,
-					      range->bit, false);
-			goto out;
+			regmap_update_bits(ag->sysctrl, 0x78, BIT(range->bit), 0);
+			return;
 		}
 	}
-
 	for (i = 0; i < ARRAY_SIZE(anyka_sharepin_clr_con2); i++) {
 		const struct anyka_sharepin_range *range = &anyka_sharepin_clr_con2[i];
 
 		if (offset >= range->start && offset <= range->end) {
-			anyka_gpio_update_bit(ag->base + ANYKA_GPIO_SHAREPIN_CON2,
-					      range->bit, false);
-			goto out;
+			regmap_update_bits(ag->sysctrl, 0x74, BIT(range->bit), 0);
+			return;
 		}
 	}
-
 	for (i = 0; i < ARRAY_SIZE(anyka_sharepin_set_con2); i++) {
 		const struct anyka_sharepin_range *range = &anyka_sharepin_set_con2[i];
 
 		if (offset >= range->start && offset <= range->end) {
-			anyka_gpio_update_bit(ag->base + ANYKA_GPIO_SHAREPIN_CON2,
-					      range->bit, true);
-			goto out;
+			regmap_update_bits(ag->sysctrl, 0x74, BIT(range->bit), BIT(range->bit));
+			return;
 		}
 	}
-
-out:
-	spin_unlock_irqrestore(&ag->lock, flags);
 }
 
 static int anyka_gpio_request(struct gpio_chip *gc, unsigned int offset)
@@ -466,6 +460,11 @@ static int anyka_gpio_probe(struct platform_device *pdev)
 	if (IS_ERR(ag->base))
 		return PTR_ERR(ag->base);
 
+	ag->sysctrl = syscon_regmap_lookup_by_compatible("anyka,ak880x-sysctrl");
+	if (IS_ERR(ag->sysctrl))
+		return dev_err_probe(&pdev->dev, PTR_ERR(ag->sysctrl), "no sysctrl\n");
+	ag->ak7802 = of_device_is_compatible(pdev->dev.of_node, "anyka,ak7802-gpio");
+
 	device_property_read_u32(&pdev->dev, "ngpios", &ngpio);
 
 	spin_lock_init(&ag->lock);
@@ -526,6 +525,7 @@ static int anyka_gpio_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id anyka_gpio_of_match[] = {
+	{ .compatible = "anyka,ak7802-gpio" },
 	{ .compatible = "anyka,ak880x-gpio" },
 	{ }
 };
diff --git a/drivers/pinctrl/pinctrl-anyka.c b/drivers/pinctrl/pinctrl-anyka.c
index 039ee4fe8..1f013785c 100644
--- a/drivers/pinctrl/pinctrl-anyka.c
+++ b/drivers/pinctrl/pinctrl-anyka.c
@@ -131,6 +131,7 @@ static const unsigned int nand_pins[] = { 30, 31, 32, 33, 34, 35, 36, 37 };
 static const unsigned int sdmmc1_pins[] = { 30, 31, 32, 33, 34, 35, 36, 37 };
 static const unsigned int sdmmc2_pins[] = { 72, 73, 74, 75 };
 static const unsigned int sdio_pins[] = { 24, 25, 26, 27, 28, 29 };
+static const unsigned int uart1_pins[] = { 14, 15 };
 static const unsigned int spi1_pins[] = { 76, 77, 78, 79 };
 
 static const struct anyka_pmx_reg lcd_regs[] = {
@@ -162,7 +163,18 @@ static const struct anyka_pmx_reg spi1_regs[] = {
 	  BIT(30) | BIT(4) },
 };
 
+static const struct anyka_pmx_reg uart1_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, BIT(9), BIT(9) },
+};
+
+static const struct anyka_pmx_reg uart1_gpio_regs[] = {
+	{ ANYKA_SHAREPIN_CON1, BIT(9), 0 },
+};
+
 static const struct anyka_pin_group anyka_groups[] = {
+	{ "uart1", uart1_pins, ARRAY_SIZE(uart1_pins), uart1_regs, ARRAY_SIZE(uart1_regs) },
+	{ "uart1-gpio", uart1_pins, ARRAY_SIZE(uart1_pins),
+	  uart1_gpio_regs, ARRAY_SIZE(uart1_gpio_regs) },
 	{ "lcd", lcd_pins, ARRAY_SIZE(lcd_pins), lcd_regs, ARRAY_SIZE(lcd_regs) },
 	{ "nand", nand_pins, ARRAY_SIZE(nand_pins), nand_regs, ARRAY_SIZE(nand_regs) },
 	{ "sdmmc1", sdmmc1_pins, ARRAY_SIZE(sdmmc1_pins), sdmmc1_regs, ARRAY_SIZE(sdmmc1_regs) },
@@ -177,7 +189,12 @@ static const char * const sdmmc_groups[] = { "sdmmc1", "sdmmc2" };
 static const char * const sdio_groups[] = { "sdio" };
 static const char * const spi1_groups[] = { "spi1" };
 
+static const char * const uart1_groups[] = { "uart1" };
+static const char * const uart1_gpio_groups[] = { "uart1-gpio" };
+
 static const struct anyka_pmx_func anyka_functions[] = {
+	{ "uart1", uart1_groups, ARRAY_SIZE(uart1_groups) },
+	{ "gpio", uart1_gpio_groups, ARRAY_SIZE(uart1_gpio_groups) },
 	{ "lcd", lcd_groups, ARRAY_SIZE(lcd_groups) },
 	{ "nand", nand_groups, ARRAY_SIZE(nand_groups) },
 	{ "sdmmc", sdmmc_groups, ARRAY_SIZE(sdmmc_groups) },
