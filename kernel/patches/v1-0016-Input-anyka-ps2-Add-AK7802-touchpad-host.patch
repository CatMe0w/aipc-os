diff --git a/arch/arm/boot/dts/anyka/ak7802-netbook.dts b/arch/arm/boot/dts/anyka/ak7802-netbook.dts
index 4904e7d92..0d1307597 100644
--- a/arch/arm/boot/dts/anyka/ak7802-netbook.dts
+++ b/arch/arm/boot/dts/anyka/ak7802-netbook.dts
@@ -128,3 +128,12 @@ &mmc0 {
 	anyka,input-clock-hz = <124000000>;
 	status = "okay";
 };
+
+&ps2 {
+	pinctrl-names = "default", "gpio";
+	pinctrl-0 = <&uart1_pins>;
+	pinctrl-1 = <&uart1_gpio_pins>;
+	clk-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
+	data-gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/anyka/ak7802.dtsi b/arch/arm/boot/dts/anyka/ak7802.dtsi
index 4b8755c01..b68b63ede 100644
--- a/arch/arm/boot/dts/anyka/ak7802.dtsi
+++ b/arch/arm/boot/dts/anyka/ak7802.dtsi
@@ -23,6 +23,16 @@ pinctrl: pinctrl {
 		compatible = "anyka,ak7802-pinctrl";
 		syscon = <&sysctrl>;
 
+		uart1_pins: uart1-pins {
+			function = "uart1";
+			groups = "uart1";
+		};
+
+		uart1_gpio_pins: uart1-gpio-pins {
+			function = "gpio";
+			groups = "uart1-gpio";
+		};
+
 		lcd_pins: lcd-pins {
 			function = "lcd";
 			groups = "lcd";
@@ -53,7 +63,7 @@ sdio_pins: sdio-pins {
 	};
 
 	gpio: gpio-controller@8000074 {
-		compatible = "anyka,ak880x-gpio";
+		compatible = "anyka,ak7802-gpio", "anyka,ak880x-gpio";
 		reg = <0x8000074 0x8c>;
 		interrupt-parent = <&sysctrl_intc>;
 		interrupts = <10>;
@@ -64,6 +74,22 @@ gpio: gpio-controller@8000074 {
 		ngpios = <117>;
 	};
 
+	l2ctrl: system-controller@2002c000 {
+		compatible = "anyka,ak7802-l2ctrl", "syscon";
+		reg = <0x2002c000 0x100>;
+	};
+
+	ps2: ps2@20026000 {
+		compatible = "anyka,ak7802-ps2";
+		reg = <0x20026000 0x10>, <0x48001080 0x80>;
+		reg-names = "uart", "rx-buffer";
+		interrupt-parent = <&main_intc>;
+		interrupts = <16>;
+		syscon = <&sysctrl>;
+		anyka,l2-syscon = <&l2ctrl>;
+		status = "disabled";
+	};
+
 	main_intc: interrupt-controller@8000000 {
 		compatible = "anyka,ak880x-intc";
 		reg = <0x8000000 0x1000>;
