diff --git a/drivers/mmc/host/anyka-mmc.c b/drivers/mmc/host/anyka-mmc.c
new file mode 100644
index 000000000..85837f776
--- /dev/null
+++ b/drivers/mmc/host/anyka-mmc.c
@@ -0,0 +1,1218 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK78/AK88/AK98 MCI host controller driver.
+ *
+ * Copyright (C) 2026 CatMe0w
+ * Based on vendor kernel code provided by:
+ * Copyright (C) 2001-2010 ANYKA LTD.
+ */
+
+#include <linux/bitops.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/mfd/syscon.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+#include <linux/mmc/slot-gpio.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/scatterlist.h>
+#include <linux/sizes.h>
+#include <linux/spinlock.h>
+
+#define ANYKA_MCI_CLOCK		0x04
+#define ANYKA_MCI_ARGUMENT	0x08
+#define ANYKA_MCI_COMMAND	0x0c
+#define ANYKA_MCI_RESPONSE0	0x14
+#define ANYKA_MCI_RESPONSE1	0x18
+#define ANYKA_MCI_RESPONSE2	0x1c
+#define ANYKA_MCI_RESPONSE3	0x20
+#define ANYKA_MCI_DATATIMER	0x24
+#define ANYKA_MCI_DATALENGTH	0x28
+#define ANYKA_MCI_DATACTRL	0x2c
+#define ANYKA_MCI_DATACNT	0x30
+#define ANYKA_MCI_STATUS	0x34
+#define ANYKA_MCI_MASK		0x38
+#define ANYKA_MCI_DMACTRL	0x3c
+#define ANYKA_MCI_FIFO		0x40
+
+#define ANYKA_CLK_ENABLE	BIT(16)
+#define ANYKA_CLK_FAIL		BIT(19)
+#define ANYKA_CLK_MCI_ENABLE	BIT(20)
+
+#define ANYKA_CPSM_ENABLE	BIT(0)
+#define ANYKA_CPSM_CMD(x)	(((x) & 0x7f) << 1)
+#define ANYKA_CPSM_RESPONSE	BIT(7)
+#define ANYKA_CPSM_LONGRSP	BIT(8)
+#define ANYKA_CPSM_NOCRC	BIT(10)
+#define ANYKA_CPSM_WITHDATA	BIT(11)
+
+#define ANYKA_DPSM_ENABLE	BIT(0)
+#define ANYKA_DPSM_READ		BIT(1)
+#define ANYKA_DPSM_BUSMODE(x)	(((x) & 0x3) << 3)
+#define ANYKA_DPSM_BLKSIZE(x)	(((x) & 0xfff) << 16)
+
+#define ANYKA_DMA_BUFEN		BIT(0)
+#define ANYKA_DMA_SIZE(x)	(((x) & 0x7fff) << 17)
+
+#define ANYKA_STA_RESPCRCFAIL	BIT(0)
+#define ANYKA_STA_DATACRCFAIL	BIT(1)
+#define ANYKA_STA_RESPTIMEOUT	BIT(2)
+#define ANYKA_STA_DATATIMEOUT	BIT(3)
+#define ANYKA_STA_RESPEND	BIT(4)
+#define ANYKA_STA_CMDSENT	BIT(5)
+#define ANYKA_STA_DATAEND	BIT(6)
+#define ANYKA_STA_DATABLOCKEND	BIT(7)
+#define ANYKA_STA_STARTBITERR	BIT(8)
+#define ANYKA_STA_TXACTIVE	BIT(10)
+#define ANYKA_STA_RXACTIVE	BIT(11)
+#define ANYKA_STA_FIFOFULL	BIT(12)
+#define ANYKA_STA_FIFOEMPTY	BIT(13)
+
+#define ANYKA_DATA_ERROR	(ANYKA_STA_DATACRCFAIL | ANYKA_STA_DATATIMEOUT | \
+				 ANYKA_STA_STARTBITERR)
+#define ANYKA_DATA_READY	(ANYKA_STA_FIFOFULL | ANYKA_STA_RXACTIVE)
+#define ANYKA_WRITE_READY	(ANYKA_STA_FIFOEMPTY | ANYKA_STA_TXACTIVE)
+
+#define ANYKA_SYSCTRL_CLOCK_GATE	0x0c
+#define ANYKA_CLOCK_GATE_MMC		BIT(2)
+#define ANYKA_CLOCK_GATE_L2		BIT(3)
+
+#define ANYKA_L2_DMA_ADDRESS(id)		((id) * sizeof(u32))
+#define ANYKA_L2_DMA_COUNT(id)		(0x40 + (id) * sizeof(u32))
+#define ANYKA_L2_DMAREQ			0x80
+#define ANYKA_L2_CONF1			0x88
+#define ANYKA_L2_ASSIGN1		0x90
+#define ANYKA_L2_BUFINTEN		0x9c
+
+#define ANYKA_L2_DMAREQ_ENABLE		BIT(0)
+#define ANYKA_L2_FRACTION_REQUEST	BIT(9)
+#define ANYKA_L2_REQUEST_MASK		GENMASK(31, 16)
+#define ANYKA_L2_MCI_ASSIGN_MASK	GENMASK(14, 12)
+#define ANYKA_L2_MCI_ASSIGN(x)		(((x) & 0x7) << 12)
+#define ANYKA_L2_BUFFER_ID		2
+#define ANYKA_L2_BUFFER_REQUEST		BIT(24 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_DMA_VALID	BIT(ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_DIRECTION	BIT(8 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_VALID		BIT(16 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_CLEAR		BIT(24 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_INTEN		BIT(9 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_DMA_GRANULARITY	64
+#define ANYKA_MCI_BUFFER_WORDS		(ANYKA_MAX_BLOCK_SIZE / sizeof(u32))
+
+#define ANYKA_DEFAULT_INPUT_CLOCK	124000000
+#define ANYKA_DEFAULT_MAX_FREQ		50000000
+#define ANYKA_MAX_DIVIDER		510
+#define ANYKA_DATA_TIMEOUT		U32_MAX
+#define ANYKA_CMD_TIMEOUT_MS		50
+#define ANYKA_TRANSFER_TIMEOUT_MS	1000
+#define ANYKA_MAX_BLOCK_SIZE		512
+#define ANYKA_DMA_CHUNK_SIZE		SZ_8K
+#define ANYKA_MAX_TRANSFER_SIZE		SZ_512K
+#define ANYKA_MAX_BLOCK_COUNT		(ANYKA_MAX_TRANSFER_SIZE / \
+					 ANYKA_MAX_BLOCK_SIZE)
+#define ANYKA_MAX_SEGMENTS		(ANYKA_MAX_TRANSFER_SIZE / SZ_4K)
+
+#define ANYKA_CMD_EVENTS	(ANYKA_STA_RESPCRCFAIL | \
+				 ANYKA_STA_RESPTIMEOUT | \
+				 ANYKA_STA_RESPEND | ANYKA_STA_CMDSENT)
+#define ANYKA_DATA_EVENTS	(ANYKA_DATA_ERROR | ANYKA_STA_DATAEND)
+
+struct anyka_mmc {
+	struct device *dev;
+	struct mmc_host *mmc;
+	struct regmap *sysctrl;
+	void __iomem *base;
+	void __iomem *l2_base;
+	struct completion command_done;
+	struct completion data_done;
+	struct completion l2_done;
+	/* Protects irq_mask. */
+	spinlock_t irq_lock;
+	u32 irq_mask;
+	u32 command_status;
+	u32 data_status;
+	u32 l2_request;
+	int mci_irq;
+	int l2_irq;
+	struct scatterlist *dma_sg;
+	unsigned int dma_sg_count;
+	unsigned int dma_sg_index;
+	size_t dma_sg_offset;
+	size_t dma_submitted;
+	u32 pio_buffer[ANYKA_MCI_BUFFER_WORDS];
+	u32 input_clock;
+	u32 bus_clock;
+	unsigned char bus_width;
+	unsigned char power_mode;
+};
+
+static void anyka_mmc_write(struct anyka_mmc *host, unsigned int reg, u32 val)
+{
+	writel_relaxed(val, host->base + reg);
+}
+
+static u32 anyka_mmc_read(struct anyka_mmc *host, unsigned int reg)
+{
+	return readl_relaxed(host->base + reg);
+}
+
+static void anyka_mmc_l2_write(struct anyka_mmc *host, unsigned int reg,
+			       u32 val)
+{
+	writel_relaxed(val, host->l2_base + reg);
+}
+
+static u32 anyka_mmc_l2_read(struct anyka_mmc *host, unsigned int reg)
+{
+	return readl_relaxed(host->l2_base + reg);
+}
+
+static void anyka_mmc_enable_irqs(struct anyka_mmc *host, u32 mask)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&host->irq_lock, flags);
+	host->irq_mask |= mask;
+	anyka_mmc_write(host, ANYKA_MCI_MASK, host->irq_mask);
+	spin_unlock_irqrestore(&host->irq_lock, flags);
+}
+
+static void anyka_mmc_disable_irqs(struct anyka_mmc *host, u32 mask)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&host->irq_lock, flags);
+	host->irq_mask &= ~mask;
+	anyka_mmc_write(host, ANYKA_MCI_MASK, host->irq_mask);
+	spin_unlock_irqrestore(&host->irq_lock, flags);
+}
+
+static void anyka_mmc_prepare_command_irq(struct anyka_mmc *host)
+{
+	reinit_completion(&host->command_done);
+	WRITE_ONCE(host->command_status, 0);
+	anyka_mmc_enable_irqs(host, ANYKA_CMD_EVENTS);
+}
+
+static void anyka_mmc_prepare_data_irq(struct anyka_mmc *host)
+{
+	reinit_completion(&host->data_done);
+	WRITE_ONCE(host->data_status, 0);
+	anyka_mmc_enable_irqs(host, ANYKA_DATA_EVENTS);
+}
+
+static void anyka_mmc_l2_clear_status(struct anyka_mmc *host)
+{
+	u32 value = anyka_mmc_l2_read(host, ANYKA_L2_CONF1);
+
+	anyka_mmc_l2_write(host, ANYKA_L2_CONF1,
+			   value | ANYKA_L2_BUFFER_CLEAR);
+}
+
+static void anyka_mmc_l2_configure(struct anyka_mmc *host)
+{
+	u32 value;
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_DMAREQ);
+	value &= ~(ANYKA_L2_FRACTION_REQUEST | ANYKA_L2_REQUEST_MASK);
+	value |= ANYKA_L2_DMAREQ_ENABLE;
+	anyka_mmc_l2_write(host, ANYKA_L2_DMAREQ, value);
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_ASSIGN1);
+	value &= ~ANYKA_L2_MCI_ASSIGN_MASK;
+	value |= ANYKA_L2_MCI_ASSIGN(ANYKA_L2_BUFFER_ID);
+	anyka_mmc_l2_write(host, ANYKA_L2_ASSIGN1, value);
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_CONF1);
+	value &= ~ANYKA_L2_BUFFER_DIRECTION;
+	value |= ANYKA_L2_BUFFER_DMA_VALID | ANYKA_L2_BUFFER_VALID;
+	anyka_mmc_l2_write(host, ANYKA_L2_CONF1, value);
+	anyka_mmc_l2_clear_status(host);
+}
+
+static void anyka_mmc_l2_start_dma(struct anyka_mmc *host,
+				   dma_addr_t address, size_t bytes, bool write)
+{
+	unsigned long flags;
+	u32 value;
+
+	local_irq_save(flags);
+	anyka_mmc_l2_write(host, ANYKA_L2_DMA_ADDRESS(ANYKA_L2_BUFFER_ID),
+			   lower_32_bits(address));
+	anyka_mmc_l2_write(host, ANYKA_L2_DMA_COUNT(ANYKA_L2_BUFFER_ID),
+			   bytes / ANYKA_L2_DMA_GRANULARITY);
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_CONF1);
+	if (write)
+		value |= ANYKA_L2_BUFFER_DIRECTION;
+	else
+		value &= ~ANYKA_L2_BUFFER_DIRECTION;
+	value |= ANYKA_L2_BUFFER_DMA_VALID | ANYKA_L2_BUFFER_VALID;
+	anyka_mmc_l2_write(host, ANYKA_L2_CONF1, value);
+
+	if (write)
+		dma_wmb();
+	reinit_completion(&host->l2_done);
+	WRITE_ONCE(host->l2_request, ANYKA_L2_BUFFER_REQUEST);
+	/* An enabled idle buffer asserts the L2 interrupt. */
+	value = anyka_mmc_l2_read(host, ANYKA_L2_DMAREQ);
+	value &= ~(ANYKA_L2_FRACTION_REQUEST | ANYKA_L2_REQUEST_MASK);
+	value |= ANYKA_L2_DMAREQ_ENABLE | ANYKA_L2_BUFFER_REQUEST;
+	anyka_mmc_l2_write(host, ANYKA_L2_DMAREQ, value);
+	value = anyka_mmc_l2_read(host, ANYKA_L2_BUFINTEN);
+	value |= ANYKA_L2_BUFFER_INTEN;
+	anyka_mmc_l2_write(host, ANYKA_L2_BUFINTEN, value);
+	local_irq_restore(flags);
+}
+
+static void anyka_mmc_l2_abort_dma(struct anyka_mmc *host)
+{
+	u32 value;
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_BUFINTEN);
+	value &= ~ANYKA_L2_BUFFER_INTEN;
+	anyka_mmc_l2_write(host, ANYKA_L2_BUFINTEN, value);
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_DMAREQ);
+
+	if (!(value & ANYKA_L2_BUFFER_REQUEST))
+		return;
+
+	value &= ~ANYKA_L2_BUFFER_REQUEST;
+	value |= ANYKA_L2_DMAREQ_ENABLE;
+	anyka_mmc_l2_write(host, ANYKA_L2_DMAREQ, value);
+	anyka_mmc_l2_write(host, ANYKA_L2_DMA_COUNT(ANYKA_L2_BUFFER_ID), 0);
+	anyka_mmc_l2_clear_status(host);
+}
+
+static void anyka_mmc_stop_data(struct anyka_mmc *host)
+{
+	anyka_mmc_disable_irqs(host, ANYKA_CMD_EVENTS | ANYKA_DATA_EVENTS);
+	anyka_mmc_write(host, ANYKA_MCI_COMMAND, 0);
+	anyka_mmc_write(host, ANYKA_MCI_DATACTRL, 0);
+	anyka_mmc_write(host, ANYKA_MCI_DATALENGTH, 0);
+	anyka_mmc_write(host, ANYKA_MCI_DMACTRL, 0);
+	anyka_mmc_l2_abort_dma(host);
+}
+
+static int anyka_mmc_wait_command_irq(struct anyka_mmc *host,
+				      unsigned int timeout_ms, u32 *out)
+{
+	unsigned long timeout = msecs_to_jiffies(timeout_ms);
+	u32 status;
+
+	if (!wait_for_completion_timeout(&host->command_done,
+					 max_t(unsigned long, timeout, 1))) {
+		anyka_mmc_disable_irqs(host, ANYKA_CMD_EVENTS);
+		status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+		if (out)
+			*out = status;
+		return -ETIMEDOUT;
+	}
+
+	status = READ_ONCE(host->command_status);
+	if (out)
+		*out = status;
+
+	return 0;
+}
+
+static int anyka_mmc_wait_data_irq(struct anyka_mmc *host, u32 *out)
+{
+	unsigned long timeout = msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+	u32 status;
+
+	if (!wait_for_completion_timeout(&host->data_done,
+					 max_t(unsigned long, timeout, 1))) {
+		anyka_mmc_disable_irqs(host, ANYKA_DATA_EVENTS);
+		status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+		if (out)
+			*out = status;
+		return -ETIMEDOUT;
+	}
+
+	status = READ_ONCE(host->data_status);
+	if (out)
+		*out = status;
+
+	return 0;
+}
+
+static int anyka_mmc_wait_l2_irq(struct anyka_mmc *host, u32 *out)
+{
+	unsigned long timeout = msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+	u32 request;
+	u32 value;
+
+	if (!wait_for_completion_timeout(&host->l2_done,
+					 max_t(unsigned long, timeout, 1))) {
+		value = anyka_mmc_l2_read(host, ANYKA_L2_BUFINTEN);
+		value &= ~ANYKA_L2_BUFFER_INTEN;
+		anyka_mmc_l2_write(host, ANYKA_L2_BUFINTEN, value);
+		request = anyka_mmc_l2_read(host, ANYKA_L2_DMAREQ);
+		if (out)
+			*out = request;
+		return -ETIMEDOUT;
+	}
+
+	request = READ_ONCE(host->l2_request);
+	if (out)
+		*out = request;
+
+	return request & ANYKA_L2_BUFFER_REQUEST ? -EIO : 0;
+}
+
+static irqreturn_t anyka_mmc_irq(int irq, void *data)
+{
+	struct anyka_mmc *host = data;
+	unsigned long flags;
+	bool command_done = false;
+	bool data_done = false;
+	u32 active;
+	u32 status;
+
+	status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+	spin_lock_irqsave(&host->irq_lock, flags);
+	active = status & host->irq_mask;
+	if (active & ANYKA_CMD_EVENTS) {
+		WRITE_ONCE(host->command_status, status);
+		host->irq_mask &= ~ANYKA_CMD_EVENTS;
+		command_done = true;
+	}
+	if (active & ANYKA_DATA_EVENTS) {
+		WRITE_ONCE(host->data_status, status);
+		host->irq_mask &= ~ANYKA_DATA_EVENTS;
+		data_done = true;
+	}
+	if (command_done || data_done)
+		anyka_mmc_write(host, ANYKA_MCI_MASK, host->irq_mask);
+	spin_unlock_irqrestore(&host->irq_lock, flags);
+
+	if (command_done)
+		complete(&host->command_done);
+	if (data_done)
+		complete(&host->data_done);
+
+	return command_done || data_done ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static irqreturn_t anyka_mmc_l2_irq(int irq, void *data)
+{
+	struct anyka_mmc *host = data;
+	u32 request;
+	u32 value;
+
+	value = anyka_mmc_l2_read(host, ANYKA_L2_BUFINTEN);
+	if (!(value & ANYKA_L2_BUFFER_INTEN))
+		return IRQ_NONE;
+
+	request = anyka_mmc_l2_read(host, ANYKA_L2_DMAREQ);
+	if (request & ANYKA_L2_BUFFER_REQUEST)
+		return IRQ_NONE;
+
+	value &= ~ANYKA_L2_BUFFER_INTEN;
+	anyka_mmc_l2_write(host, ANYKA_L2_BUFINTEN, value);
+	WRITE_ONCE(host->l2_request, request);
+	complete(&host->l2_done);
+
+	return IRQ_HANDLED;
+}
+
+static void anyka_mmc_hw_reset(struct anyka_mmc *host)
+{
+	u32 con2 = 0, con1 = 0, pupd2 = 0;
+
+	regmap_update_bits(host->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+			   ANYKA_CLOCK_GATE_L2, 0);
+	regmap_update_bits(host->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+			   ANYKA_CLOCK_GATE_MMC, ANYKA_CLOCK_GATE_MMC);
+	udelay(10);
+	regmap_update_bits(host->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+			   ANYKA_CLOCK_GATE_MMC, 0);
+	udelay(10);
+
+	anyka_mmc_stop_data(host);
+	anyka_mmc_write(host, ANYKA_MCI_DATATIMER, ANYKA_DATA_TIMEOUT);
+	anyka_mmc_l2_configure(host);
+
+	regmap_read(host->sysctrl, 0x74, &con2);
+	regmap_read(host->sysctrl, 0x78, &con1);
+	regmap_read(host->sysctrl, 0xa0, &pupd2);
+	dev_info(host->dev,
+		 "hw reset: sharepin2=0x%08x sharepin1=0x%08x pupd2=0x%08x sta=0x%08x\n",
+		 con2, con1, pupd2, anyka_mmc_read(host, ANYKA_MCI_STATUS));
+}
+
+static void anyka_mmc_set_clock(struct anyka_mmc *host, unsigned int rate)
+{
+	u32 divider, low, high, clock;
+
+	if (!rate) {
+		clock = anyka_mmc_read(host, ANYKA_MCI_CLOCK);
+		clock &= ~ANYKA_CLK_ENABLE;
+		anyka_mmc_write(host, ANYKA_MCI_CLOCK, clock);
+		host->bus_clock = 0;
+		return;
+	}
+
+	divider = DIV_ROUND_UP(host->input_clock, rate);
+	if (divider > 2)
+		divider -= 2;
+	else
+		divider = 0;
+	divider = min_t(u32, divider, ANYKA_MAX_DIVIDER);
+
+	low = divider - divider / 2;
+	high = divider / 2;
+	clock = ANYKA_CLK_MCI_ENABLE | ANYKA_CLK_FAIL |
+		ANYKA_CLK_ENABLE | (high << 8) | low;
+
+	anyka_mmc_write(host, ANYKA_MCI_CLOCK, clock);
+	host->bus_clock = host->input_clock / (divider + 2);
+	udelay(10);
+}
+
+static void anyka_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	struct anyka_mmc *host = mmc_priv(mmc);
+
+	if (ios->power_mode != host->power_mode) {
+		if (ios->power_mode == MMC_POWER_OFF) {
+			anyka_mmc_set_clock(host, 0);
+			anyka_mmc_stop_data(host);
+		} else if (host->power_mode == MMC_POWER_OFF) {
+			anyka_mmc_hw_reset(host);
+			anyka_mmc_write(host, ANYKA_MCI_CLOCK,
+					ANYKA_CLK_MCI_ENABLE | ANYKA_CLK_FAIL);
+			udelay(10);
+		}
+		host->power_mode = ios->power_mode;
+	}
+
+	host->bus_width = ios->bus_width;
+	anyka_mmc_set_clock(host, ios->clock);
+	dev_info(host->dev,
+		 "set_ios: power=%u clock=%u actual=%u width=%u clkreg=0x%08x sta=0x%08x\n",
+		 ios->power_mode, ios->clock, host->bus_clock, ios->bus_width,
+		 anyka_mmc_read(host, ANYKA_MCI_CLOCK),
+		 anyka_mmc_read(host, ANYKA_MCI_STATUS));
+}
+
+static bool anyka_mmc_uses_dma(struct mmc_data *data)
+{
+	size_t total = data->blksz * data->blocks;
+
+	return data->blksz == ANYKA_MAX_BLOCK_SIZE &&
+		total >= ANYKA_MAX_BLOCK_SIZE &&
+		IS_ALIGNED(total, ANYKA_L2_DMA_GRANULARITY);
+}
+
+static int anyka_mmc_map_data(struct anyka_mmc *host,
+			      struct mmc_data *data, size_t total)
+{
+	struct scatterlist *sg;
+	size_t mapped = 0;
+	int i;
+
+	data->sg_count = dma_map_sg(host->dev, data->sg, data->sg_len,
+				    mmc_get_dma_dir(data));
+	if (!data->sg_count)
+		return -ENOMEM;
+
+	for_each_sg(data->sg, sg, data->sg_count, i) {
+		dma_addr_t address = sg_dma_address(sg);
+		size_t length = sg_dma_len(sg);
+
+		if (!length || !IS_ALIGNED(address, ANYKA_L2_DMA_GRANULARITY) ||
+		    !IS_ALIGNED(length, ANYKA_L2_DMA_GRANULARITY) ||
+		    upper_32_bits(address) || length > total - mapped) {
+			dev_err(host->dev,
+				"unsupported DMA segment %d: addr=%pad len=%zu\n",
+				i, &address, length);
+			goto invalid;
+		}
+		mapped += length;
+	}
+
+	if (mapped != total) {
+		dev_err(host->dev, "DMA length mismatch: mapped=%zu total=%zu\n",
+			mapped, total);
+		goto invalid;
+	}
+
+	host->dma_sg = data->sg;
+	host->dma_sg_count = data->sg_count;
+	host->dma_sg_index = 0;
+	host->dma_sg_offset = 0;
+	host->dma_submitted = 0;
+
+	return 0;
+
+invalid:
+	dma_unmap_sg(host->dev, data->sg, data->sg_len,
+		     mmc_get_dma_dir(data));
+	data->sg_count = 0;
+	return -EINVAL;
+}
+
+static void anyka_mmc_unmap_data(struct anyka_mmc *host,
+				 struct mmc_data *data)
+{
+	dma_unmap_sg(host->dev, data->sg, data->sg_len,
+		     mmc_get_dma_dir(data));
+	data->sg_count = 0;
+	host->dma_sg = NULL;
+	host->dma_sg_count = 0;
+	host->dma_sg_index = 0;
+	host->dma_sg_offset = 0;
+	host->dma_submitted = 0;
+}
+
+static bool anyka_mmc_next_dma_chunk(struct anyka_mmc *host,
+				     dma_addr_t *address, size_t *bytes)
+{
+	size_t available;
+
+	while (host->dma_sg_index < host->dma_sg_count) {
+		available = sg_dma_len(host->dma_sg) - host->dma_sg_offset;
+		if (available) {
+			*address = sg_dma_address(host->dma_sg) +
+				   host->dma_sg_offset;
+			*bytes = min_t(size_t, available,
+				       ANYKA_DMA_CHUNK_SIZE);
+			host->dma_sg_offset += *bytes;
+			host->dma_submitted += *bytes;
+			return true;
+		}
+
+		host->dma_sg_index++;
+		host->dma_sg_offset = 0;
+		if (host->dma_sg_index < host->dma_sg_count)
+			host->dma_sg = sg_next(host->dma_sg);
+	}
+
+	return false;
+}
+
+static int anyka_mmc_setup_data(struct anyka_mmc *host,
+				struct mmc_data *data)
+{
+	bool dma = anyka_mmc_uses_dma(data);
+	dma_addr_t address;
+	size_t bytes;
+	u32 datactrl;
+	u32 total = data->blksz * data->blocks;
+
+	if (dma) {
+		if (!anyka_mmc_next_dma_chunk(host, &address, &bytes))
+			return -EIO;
+		anyka_mmc_prepare_data_irq(host);
+		anyka_mmc_l2_configure(host);
+		anyka_mmc_l2_start_dma(host, address, bytes,
+				       data->flags & MMC_DATA_WRITE);
+		anyka_mmc_write(host, ANYKA_MCI_DMACTRL,
+				ANYKA_DMA_BUFEN |
+				ANYKA_DMA_SIZE(ANYKA_MCI_BUFFER_WORDS));
+	} else {
+		anyka_mmc_write(host, ANYKA_MCI_DMACTRL, 0);
+	}
+	anyka_mmc_write(host, ANYKA_MCI_DATATIMER, ANYKA_DATA_TIMEOUT);
+	anyka_mmc_write(host, ANYKA_MCI_DATALENGTH, total);
+
+	datactrl = ANYKA_DPSM_ENABLE;
+	if (data->flags & MMC_DATA_READ)
+		datactrl |= ANYKA_DPSM_READ;
+	datactrl |= ANYKA_DPSM_BLKSIZE(data->blksz);
+
+	if (host->bus_width == MMC_BUS_WIDTH_4)
+		datactrl |= ANYKA_DPSM_BUSMODE(1);
+	else if (host->bus_width == MMC_BUS_WIDTH_8)
+		datactrl |= ANYKA_DPSM_BUSMODE(2);
+
+	anyka_mmc_write(host, ANYKA_MCI_DATACTRL, datactrl);
+
+	return 0;
+}
+
+static int anyka_mmc_read_fifo(struct anyka_mmc *host, struct mmc_data *data,
+			       u32 *buffer)
+{
+	unsigned long timeout;
+	unsigned int i, words;
+	u32 observed = 0;
+	u32 status;
+	size_t total = data->blksz * data->blocks;
+
+	words = DIV_ROUND_UP(total, sizeof(u32));
+	timeout = jiffies + msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+
+	for (i = 0; i < words; ) {
+		status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+		observed |= status;
+		if (status & ANYKA_DATA_ERROR) {
+			return (status & ANYKA_STA_DATATIMEOUT) ?
+				-ETIMEDOUT : -EILSEQ;
+		}
+
+		if ((status & ANYKA_DATA_READY) == ANYKA_DATA_READY) {
+			buffer[i++] = anyka_mmc_read(host, ANYKA_MCI_FIFO);
+			timeout = jiffies + msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+			continue;
+		}
+		if (status & ANYKA_STA_DATAEND)
+			return -EIO;
+
+		if (time_after_eq(jiffies, timeout))
+			return -ETIMEDOUT;
+		cpu_relax();
+	}
+
+	timeout = jiffies + msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+	for (;;) {
+		status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+		observed |= status;
+		if (status & ANYKA_DATA_ERROR)
+			return (status & ANYKA_STA_DATATIMEOUT) ?
+				-ETIMEDOUT : -EILSEQ;
+		if ((observed & (ANYKA_STA_DATAEND |
+				 ANYKA_STA_DATABLOCKEND)) ==
+		    (ANYKA_STA_DATAEND | ANYKA_STA_DATABLOCKEND))
+			break;
+		if (time_after_eq(jiffies, timeout))
+			return -ETIMEDOUT;
+		cpu_relax();
+	}
+
+	return 0;
+}
+
+static int anyka_mmc_write_fifo(struct anyka_mmc *host,
+				struct mmc_data *data, const u32 *buffer)
+{
+	unsigned long timeout;
+	unsigned int i, words;
+	u32 observed = 0;
+	u32 status;
+	size_t total = data->blksz * data->blocks;
+
+	words = DIV_ROUND_UP(total, sizeof(u32));
+	timeout = jiffies + msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+
+	for (i = 0; i < words; ) {
+		status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+		observed |= status;
+		if (status & ANYKA_DATA_ERROR) {
+			return (status & ANYKA_STA_DATATIMEOUT) ?
+				-ETIMEDOUT : -EILSEQ;
+		}
+
+		if ((status & ANYKA_WRITE_READY) == ANYKA_WRITE_READY) {
+			anyka_mmc_write(host, ANYKA_MCI_FIFO, buffer[i++]);
+			timeout = jiffies +
+				msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+			continue;
+		}
+		if (status & ANYKA_STA_DATAEND)
+			return -EIO;
+
+		if (time_after_eq(jiffies, timeout))
+			return -ETIMEDOUT;
+		cpu_relax();
+	}
+
+	timeout = jiffies + msecs_to_jiffies(ANYKA_TRANSFER_TIMEOUT_MS);
+	for (;;) {
+		status = anyka_mmc_read(host, ANYKA_MCI_STATUS);
+		observed |= status;
+		if (status & ANYKA_DATA_ERROR)
+			return (status & ANYKA_STA_DATATIMEOUT) ?
+				-ETIMEDOUT : -EILSEQ;
+		if ((observed & (ANYKA_STA_DATAEND |
+				 ANYKA_STA_DATABLOCKEND)) ==
+		    (ANYKA_STA_DATAEND | ANYKA_STA_DATABLOCKEND))
+			break;
+		if (time_after_eq(jiffies, timeout))
+			return -ETIMEDOUT;
+		cpu_relax();
+	}
+
+	return 0;
+}
+
+static int anyka_mmc_wait_dma(struct anyka_mmc *host, struct mmc_data *data)
+{
+	size_t total = data->blksz * data->blocks;
+	bool write = data->flags & MMC_DATA_WRITE;
+	u32 request = 0;
+	u32 status = 0;
+	int ret;
+
+	for (;;) {
+		ret = anyka_mmc_wait_l2_irq(host, &request);
+		if (ret)
+			break;
+		if (host->dma_submitted < total) {
+			dma_addr_t address;
+			size_t bytes;
+
+			if (!anyka_mmc_next_dma_chunk(host, &address, &bytes))
+				return -EIO;
+			anyka_mmc_l2_start_dma(host, address, bytes, write);
+			continue;
+		}
+
+		ret = anyka_mmc_wait_data_irq(host, &status);
+		if (ret)
+			break;
+		if (status & ANYKA_DATA_ERROR)
+			return (status & ANYKA_STA_DATATIMEOUT) ?
+				-ETIMEDOUT : -EILSEQ;
+		if (!(status & ANYKA_STA_DATAEND) ||
+		    anyka_mmc_read(host, ANYKA_MCI_DATACNT))
+			return -EIO;
+		return 0;
+	}
+
+	dev_err(host->dev,
+		"data DMA timeout, sta=0x%08x req=0x%08x cnt=%u\n",
+		READ_ONCE(host->data_status), request,
+		anyka_mmc_read(host, ANYKA_MCI_DATACNT));
+	return ret;
+}
+
+static int anyka_mmc_read_data(struct anyka_mmc *host, struct mmc_data *data)
+{
+	int ret;
+
+	/* Identification data smaller than one sector stays on the FIFO. */
+	if (!anyka_mmc_uses_dma(data))
+		return anyka_mmc_read_fifo(host, data, host->pio_buffer);
+
+	ret = anyka_mmc_wait_dma(host, data);
+	if (!ret)
+		dma_rmb();
+	return ret;
+}
+
+static int anyka_mmc_write_data(struct anyka_mmc *host, struct mmc_data *data)
+{
+	if (!anyka_mmc_uses_dma(data))
+		return anyka_mmc_write_fifo(host, data, host->pio_buffer);
+
+	return anyka_mmc_wait_dma(host, data);
+}
+
+static int anyka_mmc_send_command(struct anyka_mmc *host,
+				  struct mmc_command *cmd)
+{
+	u32 command, status;
+	int ret;
+
+	if (anyka_mmc_read(host, ANYKA_MCI_COMMAND) & ANYKA_CPSM_ENABLE) {
+		anyka_mmc_write(host, ANYKA_MCI_COMMAND, 0);
+		udelay(1);
+	}
+
+	command = ANYKA_CPSM_ENABLE | ANYKA_CPSM_CMD(cmd->opcode);
+	if (cmd->flags & MMC_RSP_PRESENT) {
+		command |= ANYKA_CPSM_RESPONSE;
+		if (cmd->flags & MMC_RSP_136)
+			command |= ANYKA_CPSM_LONGRSP;
+		if (!(cmd->flags & MMC_RSP_CRC))
+			command |= ANYKA_CPSM_NOCRC;
+	}
+	if (cmd->data)
+		command |= ANYKA_CPSM_WITHDATA;
+
+	anyka_mmc_write(host, ANYKA_MCI_ARGUMENT, cmd->arg);
+	anyka_mmc_prepare_command_irq(host);
+	anyka_mmc_write(host, ANYKA_MCI_COMMAND, command);
+
+	ret = anyka_mmc_wait_command_irq(host, ANYKA_CMD_TIMEOUT_MS, &status);
+
+	if (ret) {
+		dev_err(host->dev, "cmd%u timeout, sta=0x%08x clk=0x%08x\n",
+			cmd->opcode, status,
+			anyka_mmc_read(host, ANYKA_MCI_CLOCK));
+		cmd->error = ret;
+		return ret;
+	}
+
+	if (cmd->flags & MMC_RSP_136) {
+		cmd->resp[0] = anyka_mmc_read(host, ANYKA_MCI_RESPONSE0);
+		cmd->resp[1] = anyka_mmc_read(host, ANYKA_MCI_RESPONSE1);
+		cmd->resp[2] = anyka_mmc_read(host, ANYKA_MCI_RESPONSE2);
+		cmd->resp[3] = anyka_mmc_read(host, ANYKA_MCI_RESPONSE3);
+	} else {
+		cmd->resp[0] = anyka_mmc_read(host, ANYKA_MCI_RESPONSE0);
+	}
+
+	if (status & ANYKA_STA_RESPTIMEOUT) {
+		dev_err(host->dev,
+			"cmd%u response timeout, sta=0x%08x clk=0x%08x\n",
+			cmd->opcode, status,
+			anyka_mmc_read(host, ANYKA_MCI_CLOCK));
+		cmd->error = -ETIMEDOUT;
+		return cmd->error;
+	}
+
+	if ((status & ANYKA_STA_RESPCRCFAIL) && (cmd->flags & MMC_RSP_CRC)) {
+		cmd->error = -EILSEQ;
+		return cmd->error;
+	}
+
+	return 0;
+}
+
+static int anyka_mmc_send_sbc(struct anyka_mmc *host,
+			      struct mmc_request *mrq)
+{
+	int ret;
+
+	if (!mrq->sbc)
+		return 0;
+	if (mrq->sbc->opcode != MMC_SET_BLOCK_COUNT) {
+		mrq->sbc->error = -EINVAL;
+		return mrq->sbc->error;
+	}
+
+	ret = anyka_mmc_send_command(host, mrq->sbc);
+	if (!ret && R1_STATUS(mrq->sbc->resp[0])) {
+		mrq->sbc->error = -EIO;
+		ret = mrq->sbc->error;
+	}
+
+	return ret;
+}
+
+static int anyka_mmc_read_once(struct anyka_mmc *host,
+			       struct mmc_command *cmd,
+			       struct mmc_data *data)
+{
+	int ret;
+
+	ret = anyka_mmc_setup_data(host, data);
+	if (!ret)
+		ret = anyka_mmc_send_command(host, cmd);
+	if (!ret)
+		ret = anyka_mmc_read_data(host, data);
+	anyka_mmc_stop_data(host);
+
+	return ret;
+}
+
+static int anyka_mmc_write_once(struct anyka_mmc *host,
+				struct mmc_command *cmd,
+				struct mmc_data *data)
+{
+	int ret;
+
+	ret = anyka_mmc_send_command(host, cmd);
+	if (!ret && R1_STATUS(cmd->resp[0])) {
+		cmd->error = -EIO;
+		ret = cmd->error;
+	}
+	if (!ret) {
+		ret = anyka_mmc_setup_data(host, data);
+		if (!ret)
+			ret = anyka_mmc_write_data(host, data);
+	}
+	anyka_mmc_stop_data(host);
+
+	return ret;
+}
+
+static int anyka_mmc_read_blocks(struct anyka_mmc *host,
+				 struct mmc_request *mrq)
+{
+	struct mmc_data *data = mrq->cmd->data;
+	int ret;
+
+	if (mrq->cmd->opcode != MMC_READ_MULTIPLE_BLOCK ||
+	    !mrq->stop || mrq->stop->opcode != MMC_STOP_TRANSMISSION)
+		return -EINVAL;
+
+	ret = anyka_mmc_send_sbc(host, mrq);
+	if (ret)
+		goto out;
+
+	ret = anyka_mmc_read_once(host, mrq->cmd, data);
+	if (!mrq->cmd->error && (!mrq->sbc || ret))
+		anyka_mmc_send_command(host, mrq->stop);
+
+out:
+	anyka_mmc_stop_data(host);
+
+	return ret;
+}
+
+static int anyka_mmc_write_blocks(struct anyka_mmc *host,
+				  struct mmc_request *mrq)
+{
+	struct mmc_data *data = mrq->cmd->data;
+	int ret;
+
+	if (mrq->cmd->opcode != MMC_WRITE_MULTIPLE_BLOCK ||
+	    !mrq->stop || mrq->stop->opcode != MMC_STOP_TRANSMISSION)
+		return -EINVAL;
+
+	ret = anyka_mmc_send_sbc(host, mrq);
+	if (ret)
+		goto out;
+
+	ret = anyka_mmc_send_command(host, mrq->cmd);
+	if (!ret && R1_STATUS(mrq->cmd->resp[0])) {
+		mrq->cmd->error = -EIO;
+		ret = mrq->cmd->error;
+	}
+	if (!ret) {
+		ret = anyka_mmc_setup_data(host, data);
+		if (!ret)
+			ret = anyka_mmc_write_data(host, data);
+	}
+	anyka_mmc_stop_data(host);
+
+	if (!mrq->cmd->error && (!mrq->sbc || ret))
+		anyka_mmc_send_command(host, mrq->stop);
+
+out:
+	anyka_mmc_stop_data(host);
+
+	return ret;
+}
+
+static void anyka_mmc_request(struct mmc_host *mmc, struct mmc_request *mrq)
+{
+	struct anyka_mmc *host = mmc_priv(mmc);
+	struct mmc_data *data = mrq->cmd->data;
+	size_t copied, total;
+	bool dma, write;
+	int ret;
+
+	if (data) {
+		data->bytes_xfered = 0;
+		data->sg_count = 0;
+		write = data->flags & MMC_DATA_WRITE;
+
+		total = data->blksz * data->blocks;
+		if (!data->blocks || !data->blksz ||
+		    data->blocks > ANYKA_MAX_BLOCK_COUNT ||
+		    data->blksz > ANYKA_MAX_BLOCK_SIZE ||
+		    total > ANYKA_MAX_TRANSFER_SIZE ||
+		    (data->blocks > 1 &&
+		     data->blksz != ANYKA_MAX_BLOCK_SIZE)) {
+			data->error = -EINVAL;
+			mrq->cmd->error = -EINVAL;
+			mmc_request_done(mmc, mrq);
+			return;
+		}
+
+		dma = anyka_mmc_uses_dma(data);
+		if (dma) {
+			ret = anyka_mmc_map_data(host, data, total);
+			if (ret) {
+				data->error = ret;
+				mrq->cmd->error = ret;
+				mmc_request_done(mmc, mrq);
+				return;
+			}
+		} else if (write) {
+			copied = sg_copy_to_buffer(data->sg, data->sg_len,
+						   host->pio_buffer, total);
+			if (copied != total) {
+				data->error = -EIO;
+				mrq->cmd->error = -EIO;
+				mmc_request_done(mmc, mrq);
+				return;
+			}
+		}
+
+		if (data->blocks > 1) {
+			if (write)
+				ret = anyka_mmc_write_blocks(host, mrq);
+			else
+				ret = anyka_mmc_read_blocks(host, mrq);
+		} else if (write) {
+			ret = anyka_mmc_write_once(host, mrq->cmd, data);
+		} else {
+			ret = anyka_mmc_read_once(host, mrq->cmd, data);
+		}
+
+		if (!ret && !write && !dma) {
+			copied = sg_copy_from_buffer(data->sg, data->sg_len,
+						     host->pio_buffer, total);
+			if (copied != total)
+				ret = -EIO;
+		}
+		if (dma)
+			anyka_mmc_unmap_data(host, data);
+		if (!ret)
+			data->bytes_xfered = total;
+		if (ret)
+			data->error = ret;
+	} else {
+		ret = anyka_mmc_send_command(host, mrq->cmd);
+		anyka_mmc_stop_data(host);
+	}
+
+	if (mrq->stop && (!data || data->blocks == 1)) {
+		anyka_mmc_send_command(host, mrq->stop);
+		anyka_mmc_stop_data(host);
+	}
+
+	/* The MMC block completion path owns post-write CMD13 polling. */
+	mmc_request_done(mmc, mrq);
+}
+
+static int anyka_mmc_get_cd(struct mmc_host *mmc)
+{
+	int ret = mmc_gpio_get_cd(mmc);
+
+	if (ret < 0)
+		return 1;
+
+	return ret;
+}
+
+static int anyka_mmc_get_ro(struct mmc_host *mmc)
+{
+	return mmc_gpio_get_ro(mmc);
+}
+
+static const struct mmc_host_ops anyka_mmc_ops = {
+	.request = anyka_mmc_request,
+	.set_ios = anyka_mmc_set_ios,
+	.get_cd = anyka_mmc_get_cd,
+	.get_ro = anyka_mmc_get_ro,
+};
+
+static int anyka_mmc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct anyka_mmc *host;
+	struct mmc_host *mmc;
+	u32 max_freq;
+	int ret;
+
+	mmc = devm_mmc_alloc_host(dev, sizeof(*host));
+	if (!mmc)
+		return -ENOMEM;
+
+	host = mmc_priv(mmc);
+	host->dev = dev;
+	host->mmc = mmc;
+	host->power_mode = MMC_POWER_OFF;
+	host->bus_width = MMC_BUS_WIDTH_1;
+	host->input_clock = ANYKA_DEFAULT_INPUT_CLOCK;
+	spin_lock_init(&host->irq_lock);
+	init_completion(&host->command_done);
+	init_completion(&host->data_done);
+	init_completion(&host->l2_done);
+
+	host->base = devm_platform_ioremap_resource_byname(pdev, "mci");
+	if (IS_ERR(host->base))
+		return PTR_ERR(host->base);
+	host->l2_base = devm_platform_ioremap_resource_byname(pdev, "l2-ctrl");
+	if (IS_ERR(host->l2_base))
+		return PTR_ERR(host->l2_base);
+
+	ret = dma_set_mask(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return dev_err_probe(dev, ret, "32-bit DMA unavailable\n");
+
+	host->sysctrl = syscon_regmap_lookup_by_phandle(dev->of_node, "syscon");
+	if (IS_ERR(host->sysctrl))
+		return dev_err_probe(dev, PTR_ERR(host->sysctrl),
+				     "missing syscon\n");
+
+	device_property_read_u32(dev, "anyka,input-clock-hz", &host->input_clock);
+	host->mci_irq = platform_get_irq_byname(pdev, "mci");
+	if (host->mci_irq < 0)
+		return host->mci_irq;
+	host->l2_irq = platform_get_irq_byname(pdev, "l2");
+	if (host->l2_irq < 0)
+		return host->l2_irq;
+
+	ret = devm_request_irq(dev, host->mci_irq, anyka_mmc_irq, 0,
+			       "anyka-mci", host);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request MCI IRQ\n");
+	ret = devm_request_irq(dev, host->l2_irq, anyka_mmc_l2_irq, 0,
+			       "anyka-l2-dma", host);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request L2 IRQ\n");
+
+	mmc->ops = &anyka_mmc_ops;
+	mmc->ocr_avail = MMC_VDD_32_33 | MMC_VDD_33_34;
+	mmc->f_min = max_t(unsigned int,
+			   DIV_ROUND_UP(host->input_clock,
+					ANYKA_MAX_DIVIDER + 2),
+			   100000);
+	mmc->f_max = min_t(unsigned int, host->input_clock / 2,
+			   ANYKA_DEFAULT_MAX_FREQ);
+	mmc->max_req_size = ANYKA_MAX_TRANSFER_SIZE;
+	mmc->max_seg_size = ANYKA_MAX_TRANSFER_SIZE;
+	mmc->max_blk_size = ANYKA_MAX_BLOCK_SIZE;
+	mmc->max_blk_count = ANYKA_MAX_BLOCK_COUNT;
+	mmc->max_segs = ANYKA_MAX_SEGMENTS;
+	mmc->caps |= MMC_CAP_CMD23 | MMC_CAP_SD_HIGHSPEED;
+
+	ret = mmc_of_parse(mmc);
+	if (ret)
+		return ret;
+
+	if (!device_property_read_u32(dev, "max-frequency", &max_freq))
+		mmc->f_max = min_t(u32, mmc->f_max, max_freq);
+	mmc->max_sd_hs_hz = mmc->f_max;
+
+	platform_set_drvdata(pdev, mmc);
+	anyka_mmc_hw_reset(host);
+
+	ret = mmc_add_host(mmc);
+	if (ret)
+		return ret;
+
+	dev_info(dev,
+		 "registered MCI host at %u Hz, direct SG DMA, IRQs %d/%d\n",
+		 host->input_clock, host->mci_irq, host->l2_irq);
+
+	return 0;
+}
+
+static void anyka_mmc_remove(struct platform_device *pdev)
+{
+	struct mmc_host *mmc = platform_get_drvdata(pdev);
+
+	mmc_remove_host(mmc);
+}
+
+static const struct of_device_id anyka_mmc_of_match[] = {
+	{ .compatible = "anyka,ak7802-mmc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, anyka_mmc_of_match);
+
+static struct platform_driver anyka_mmc_driver = {
+	.probe = anyka_mmc_probe,
+	.remove = anyka_mmc_remove,
+	.driver = {
+		.name = "anyka-mmc",
+		.of_match_table = anyka_mmc_of_match,
+	},
+};
+module_platform_driver(anyka_mmc_driver);
+
+MODULE_DESCRIPTION("Anyka MCI SD/MMC host driver");
+MODULE_AUTHOR("CatMe0w");
+MODULE_LICENSE("GPL");
