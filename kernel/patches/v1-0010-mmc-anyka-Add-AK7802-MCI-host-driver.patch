 arch/arm/boot/dts/anyka/ak7802.dtsi        |   18 +
 drivers/mmc/host/Kconfig                   |   10 +
 drivers/mmc/host/Makefile                  |    1 +
 drivers/mmc/host/anyka-mmc.c               | 1218 ++++++++++++++++++++
 5 files changed, 1255 insertions(+)
