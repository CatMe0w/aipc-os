diff --git a/arch/arm/boot/dts/anyka/ak7802.dtsi b/arch/arm/boot/dts/anyka/ak7802.dtsi
index f3bafd793..e37ad790f 100644
--- a/arch/arm/boot/dts/anyka/ak7802.dtsi
+++ b/arch/arm/boot/dts/anyka/ak7802.dtsi
@@ -108,6 +108,24 @@ spi0: spi@20024000 {
 		status = "disabled";
 	};
 
+	mmc0: mmc@20020000 {
+		compatible = "anyka,ak7802-mmc";
+		reg = <0x20020000 0x44>,
+		      <0x2002c000 0xa4>;
+		reg-names = "mci", "l2-ctrl";
+		interrupt-parent = <&main_intc>;
+		interrupts = <22>, <10>;
