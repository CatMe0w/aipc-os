diff --git a/drivers/net/wireless/ath/ath6kl/core.h b/drivers/net/wireless/ath/ath6kl/core.h
index 77e052336..1ab88aa48 100644
--- a/drivers/net/wireless/ath/ath6kl/core.h
+++ b/drivers/net/wireless/ath/ath6kl/core.h
@@ -172,6 +172,20 @@ enum ath6kl_hw_flags {
 #define ATH6KL_FW_API4_FILE "fw-4.bin"
 #define ATH6KL_FW_API5_FILE "fw-5.bin"
 
+/* AR6002 2.0 definitions */
+#define AR6002_HW_2_0_VERSION		0x20000188
+#define AR6002_FW_DIR			"ath6k/AR6002"
+#define AR6002_FIRMWARE_FILE		"athwlan.bin.z77"
+#define AR6002_PATCH_FILE		"data.patch.hw2_0.bin"
+#define AR6002_EEPROM_FILE		"eeprom.bin"
