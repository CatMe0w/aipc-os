diff --git a/drivers/net/wireless/ath/ath6kl/ar6002.c b/drivers/net/wireless/ath/ath6kl/ar6002.c
new file mode 100644
index 000000000..007a2f72e
--- /dev/null
+++ b/drivers/net/wireless/ath/ath6kl/ar6002.c
@@ -0,0 +1,351 @@
+// SPDX-License-Identifier: ISC
+/*
+ * AR6002 firmware download and legacy WMI encoding.
+ *
+ * Copyright (c) 2026 CatMe0w
+ */
+
+#include <linux/firmware.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+
+#include "core.h"
+#include "debug.h"
+#include "hif.h"
+#include "target.h"
+
+#define AR6002_CONNECT_CMD_LEN		52
+#define AR6002_ADD_CIPHER_KEY_CMD_LEN	51
+#define AR6002_CREATE_PSTREAM_CMD_LEN	64
+#define AR6002_POWER_PARAMS_CMD_LEN	6
+#define AR6002_LPREAMBLE_CMD_LEN	1
+
+static int ath6kl_ar6002_get_blob(struct ath6kl *ar, const char *name,
+				  bool use_vmalloc, u8 **data, size_t *len)
+{
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, name, ar->dev);
+	if (ret) {
+		ath6kl_err("failed to get %s: %d\n", name, ret);
+		return ret;
+	}
+
+	*data = use_vmalloc ? vmalloc(fw->size) : kmalloc(fw->size, GFP_KERNEL);
+	if (*data) {
+		memcpy(*data, fw->data, fw->size);
+		*len = fw->size;
+	}
+
+	release_firmware(fw);
+
+	return *data ? 0 : -ENOMEM;
+}
+
+int ath6kl_ar6002_fetch_firmware(struct ath6kl *ar)
+{
+	int ret;
+
+	if (ar->testmode)
+		return -EOPNOTSUPP;
+
+	ret = ath6kl_ar6002_get_blob(ar, AR6002_FW_DIR "/" AR6002_FIRMWARE_FILE,
+				     true, &ar->fw, &ar->fw_len);
+	if (ret)
+		return ret;
+
+	ret = ath6kl_ar6002_get_blob(ar, AR6002_FW_DIR "/" AR6002_PATCH_FILE,
+				     false, &ar->fw_patch, &ar->fw_patch_len);
+	if (ret)
+		return ret;
+
+	ar->fw_api = 1;
+
+	return 0;
+}
+
+static int ath6kl_ar6002_eeprom_helper(struct ath6kl *ar)
+{
+	u8 *data = NULL, *code = NULL;
+	size_t data_len, code_len;
+	u32 result;
+	int ret;
+
+	ret = ath6kl_ar6002_get_blob(ar, AR6002_FW_DIR "/" AR6002_EEPROM_DATA_FILE,
+				     false, &data, &data_len);
+	if (ret)
+		goto out;
+	ret = ath6kl_ar6002_get_blob(ar, AR6002_FW_DIR "/" AR6002_EEPROM_FILE,
+				     false, &code, &code_len);
+	if (ret)
+		goto out;
+
+	ret = ath6kl_bmi_write(ar, 0x502070, data, data_len);
+	if (ret)
+		goto out;
+	ret = ath6kl_bmi_write(ar, 0x513950, code, code_len);
+	if (ret)
+		goto out;
+
+	ret = ath6kl_bmi_execute(ar, 0x913950, &result);
+out:
+	if (ret)
+		ath6kl_err("failed to run the AR6002 eeprom helper: %d\n", ret);
+
+	kfree(code);
+	kfree(data);
+
+	return ret;
+}
+
+int ath6kl_ar6002_upload(struct ath6kl *ar)
+{
+	u32 options, sleep, ext_clock;
+	int ret, restore;
+
+	ret = ath6kl_bmi_reg_read(ar, MBOX_BASE_ADDRESS + LOCAL_SCRATCH_ADDRESS,
+				  &options);
+	if (ret)
+		return ret;
+	ret = ath6kl_bmi_reg_read(ar, RTC_BASE_ADDRESS + SYSTEM_SLEEP_ADDRESS,
+				  &sleep);
+	if (ret)
+		return ret;
+
+	ret = ath6kl_bmi_reg_write(ar, MBOX_BASE_ADDRESS + LOCAL_SCRATCH_ADDRESS,
+				   options | ATH6KL_OPTION_SLEEP_DISABLE);
+	if (ret)
+		goto restore_sleep;
+	ret = ath6kl_bmi_reg_write(ar, RTC_BASE_ADDRESS + SYSTEM_SLEEP_ADDRESS,
+				   sleep | SM(SYSTEM_SLEEP_DISABLE, 1));
+	if (ret)
+		goto restore_sleep;
+
+	ret = ath6kl_bmi_reg_write(ar, RTC_BASE_ADDRESS + CPU_CLOCK_ADDRESS,
+				   SM(CPU_CLOCK_STANDARD, 0));
+	if (ret)
+		goto restore_sleep;
+
+	ret = ath6kl_bmi_read_hi32(ar, hi_ext_clk_detected, &ext_clock);
+	if (ret)
+		goto restore_sleep;
+	if (!ext_clock) {
+		ret = ath6kl_bmi_reg_write(ar, RTC_BASE_ADDRESS + LPO_CAL_ADDRESS,
+					   SM(LPO_CAL_ENABLE, 1));
+		if (ret)
+			goto restore_sleep;
+	}
+
+	ret = ath6kl_ar6002_eeprom_helper(ar);
+	if (ret)
+		goto restore_sleep;
+
+	ret = ath6kl_bmi_fast_download(ar, ar->hw.app_load_addr,
+				       ar->fw, ar->fw_len);
+	if (ret)
+		goto restore_sleep;
+	ret = ath6kl_bmi_set_app_start(ar, ar->hw.app_start_override_addr);
+	if (ret)
+		goto restore_sleep;
+
+	ret = ath6kl_bmi_write(ar, ar->hw.dataset_patch_addr,
+			       ar->fw_patch, ar->fw_patch_len);
+	if (ret)
+		goto restore_sleep;
+	ret = ath6kl_bmi_write_hi32(ar, hi_dset_list_head,
+				    ar->hw.dataset_patch_addr);
+
+restore_sleep:
+	restore = ath6kl_bmi_reg_write(ar, RTC_BASE_ADDRESS + SYSTEM_SLEEP_ADDRESS,
+				       sleep);
+	if (!ret)
+		ret = restore;
+	restore = ath6kl_bmi_reg_write(ar, MBOX_BASE_ADDRESS + LOCAL_SCRATCH_ADDRESS,
+				       options);
+	if (!ret)
+		ret = restore;
+
+	return ret;
+}
+
+static int ath6kl_ar6002_crypto(u8 type)
+{
+	switch (type) {
+	case NONE_CRYPT:
+		return 1;
+	case WEP_CRYPT:
+		return 2;
+	case TKIP_CRYPT:
+		return 3;
+	case AES_CRYPT:
+		return 4;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+int ath6kl_ar6002_wmi_encode(struct sk_buff *skb, enum wmi_cmd_id id)
+{
+	struct wmi_connect_cmd *connect = (void *)skb->data;
+	struct wmi_add_cipher_key_cmd *key = (void *)skb->data;
+	int pairwise, group, auth;
+
+	switch (id) {
+	case WMI_CONNECT_CMDID:
+		if (skb->len != sizeof(*connect) ||
+		    connect->nw_type != INFRA_NETWORK || connect->nw_subtype ||
+		    le32_to_cpu(connect->ctrl_flags) & ~0x3f)
+			return -EOPNOTSUPP;
+		switch (connect->auth_mode) {
+		case NONE_AUTH:
+			auth = 1;
+			break;
+		case WPA2_AUTH:
+			auth = 4;
+			break;
+		case WPA2_PSK_AUTH:
+			auth = 5;
+			break;
+		default:
+			return -EOPNOTSUPP;
+		}
+		pairwise = ath6kl_ar6002_crypto(connect->prwise_crypto_type);
+		group = ath6kl_ar6002_crypto(connect->grp_crypto_type);
+		if (pairwise < 0 || group < 0)
+			return -EOPNOTSUPP;
+		connect->auth_mode = auth;
+		connect->prwise_crypto_type = pairwise;
+		connect->grp_crypto_type = group;
+		skb_trim(skb, AR6002_CONNECT_CMD_LEN);
+		break;
+	case WMI_ADD_CIPHER_KEY_CMDID:
+		if (skb->len != sizeof(*key) || key->key_len > WLAN_MAX_KEY_LEN)
+			return -EINVAL;
+		pairwise = ath6kl_ar6002_crypto(key->key_type);
+		if (pairwise < 0)
+			return pairwise;
+		key->key_type = pairwise;
+		skb_trim(skb, AR6002_ADD_CIPHER_KEY_CMD_LEN);
+		break;
+	case WMI_CREATE_PSTREAM_CMDID:
+		if (skb->len != sizeof(struct wmi_create_pstream_cmd))
+			return -EINVAL;
+		skb_trim(skb, AR6002_CREATE_PSTREAM_CMD_LEN);
+		break;
+	case WMI_SET_POWER_PARAMS_CMDID:
+		if (skb->len != sizeof(struct wmi_power_params_cmd))
+			return -EINVAL;
+		skb_trim(skb, AR6002_POWER_PARAMS_CMD_LEN);
+		break;
+	case WMI_SET_LPREAMBLE_CMDID:
+		if (skb->len != 2)
+			return -EINVAL;
+		skb_trim(skb, AR6002_LPREAMBLE_CMD_LEN);
+		break;
+	case WMI_SET_PROBED_SSID_CMDID:
+		if (skb->len != sizeof(struct wmi_probed_ssid_cmd) ||
+		    skb->data[0] >= AR6002_MAX_PROBED_SSIDS)
+			return -EINVAL;
+		break;
+	case WMI_SET_APPIE_CMDID:
+		if (skb->len < 2 || skb->len != 2 + skb->data[1])
+			return -EINVAL;
+		if (skb->data[1] > AR6002_MAX_SCAN_IE_LEN)
+			return -EMSGSIZE;
+		break;
+	case WMI_RECONNECT_CMDID:
+	case WMI_DISCONNECT_CMDID:
+	case WMI_SYNCHRONIZE_CMDID:
+	case WMI_START_SCAN_CMDID:
+	case WMI_DELETE_PSTREAM_CMDID:
+	case WMI_SET_SCAN_PARAMS_CMDID:
+	case WMI_SET_BSS_FILTER_CMDID:
+	case WMI_SET_LISTEN_INT_CMDID:
+	case WMI_SET_BMISS_TIME_CMDID:
+	case WMI_SET_DISC_TIMEOUT_CMDID:
+	case WMI_GET_CHANNEL_LIST_CMDID:
+	case WMI_GET_STATISTICS_CMDID:
+	case WMI_SET_POWER_MODE_CMDID:
+	case WMI_DELETE_CIPHER_KEY_CMDID:
+	case WMI_SET_PMKID_CMDID:
+	case WMI_SET_TX_PWR_CMDID:
+	case WMI_GET_TX_PWR_CMDID:
+	case WMI_SET_RTS_CMDID:
+	case WMI_SET_WMM_CMDID:
+	case WMI_SET_WMM_TXOP_CMDID:
+	case WMI_SET_KEEPALIVE_CMDID:
+	case WMI_GET_KEEPALIVE_CMDID:
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	return 0;
+}
+
+int ath6kl_ar6002_parse_ready(struct ath6kl *ar, u8 *datap, int len)
+{
+	if (len == 11)
+		ath6kl_ready_event(ar, datap + 4, get_unaligned_le32(datap), 0,
+				   datap[10]);
+	else if (len == 7)
+		ath6kl_ready_event(ar, datap, 0, 0, datap[6]);
+	else
+		return -EINVAL;
+
+	return 0;
+}
+
+int ath6kl_ar6002_parse_bss_info(u8 *datap, int len,
+				 struct wmi_bss_info_hdr2 *bih, s16 *rssi)
+{
+	if (len <= AR6002_BSS_INFO_HDR_LEN)
+		return -EINVAL;
+
+	memset(bih, 0, sizeof(*bih));
+	memcpy(&bih->ch, datap, 2);
+	bih->frame_type = datap[2];
+	bih->snr = datap[3];
+	*rssi = (s16)get_unaligned_le16(datap + 4);
+	memcpy(bih->bssid, datap + 6, ETH_ALEN);
+
+	return 0;
+}
+
+int ath6kl_ar6002_parse_stats(u8 *datap, int len,
+			      struct wmi_target_stats *stats)
+{
+	if (len != AR6002_TGT_STATS_LEN)
+		return -EINVAL;
+
+	memset(stats, 0, sizeof(*stats));
+	memcpy(stats, datap, 12);
+	memcpy(&stats->stats, datap + 12, 176);
+	memcpy(&stats->wow_stats, datap + 188, 8);
+	memcpy(&stats->cserv_stats, datap + 196, 21);
+
+	return 0;
+}
+
+#define AR6002_WMI_HDR_GROWTH	(sizeof(struct wmi_data_hdr) - AR6002_WMI_HDR_LEN)
+
+int ath6kl_ar6002_expand_hdr(struct sk_buff *skb)
+{
+	if (skb->len < AR6002_WMI_HDR_LEN)
+		return -EINVAL;
+	if (skb_cow_head(skb, AR6002_WMI_HDR_GROWTH))
+		return -ENOMEM;
+
+	skb_push(skb, AR6002_WMI_HDR_GROWTH);
+	memmove(skb->data, skb->data + AR6002_WMI_HDR_GROWTH, AR6002_WMI_HDR_LEN);
+	memset(skb->data + AR6002_WMI_HDR_LEN, 0, AR6002_WMI_HDR_GROWTH);
+
+	return 0;
+}
+
+void ath6kl_ar6002_shrink_hdr(struct sk_buff *skb)
+{
+	memmove(skb->data + AR6002_WMI_HDR_GROWTH, skb->data, AR6002_WMI_HDR_LEN);
+	skb_pull(skb, AR6002_WMI_HDR_GROWTH);
+}
