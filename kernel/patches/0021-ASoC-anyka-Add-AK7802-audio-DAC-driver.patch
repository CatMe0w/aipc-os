+	SND_SOC_DAPM_OUT_DRV_E("Headphone Driver", SND_SOC_NOPM, 0, 0, NULL, 0,
+			       anyka_dac_headphone_event,
+			       SND_SOC_DAPM_POST_PMU | SND_SOC_DAPM_PRE_PMD),
