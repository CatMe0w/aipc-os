+static int anyka_dac_hw_params(struct snd_pcm_substream *substream,
+			       struct snd_pcm_hw_params *params,
+			       struct snd_soc_dai *dai)
+{
+	struct anyka_dac *dac = anyka_dac_from_card(dai->component->card);
+	unsigned int osr, divider;
+	int ret;
+
+	ret = anyka_dac_find_divider(dac, params_rate(params), &osr, &divider);
+	if (ret)
+		return ret;
+
+	dac->rate = params_rate(params);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops anyka_dac_dai_ops = {
+	.hw_params	= anyka_dac_hw_params,
+};
+
+static struct snd_soc_dai_driver anyka_dac_dai = {
+	.playback = {
+		.stream_name	= "Playback",
+		.channels_min	= 2,
+		.channels_max	= 2,
+		.rates		= SNDRV_PCM_RATE_8000_48000,
+		.rate_min	= 8000,
+		.rate_max	= 48000,
+		.formats	= SNDRV_PCM_FMTBIT_S32_LE,
+	},
+	.ops = &anyka_dac_dai_ops,
+};
+
+static struct snd_soc_dai_link *anyka_dac_create_link(struct device *dev)
+{
+	struct snd_soc_dai_link *link;
+	struct snd_soc_dai_link_component *dlc;
+
+	link = devm_kzalloc(dev, sizeof(*link), GFP_KERNEL);
+	dlc = devm_kcalloc(dev, 2, sizeof(*dlc), GFP_KERNEL);
+	if (!link || !dlc)
+		return NULL;
+
+	link->cpus = &dlc[0];
+	link->codecs = &snd_soc_dummy_dlc;
+	link->platforms = &dlc[1];
+	link->num_cpus = 1;
+	link->num_codecs = 1;
+	link->num_platforms = 1;
+
+	link->name = "dac";
+	link->stream_name = "DAC PCM";
+	link->cpus->dai_name = dev_name(dev);
+	link->platforms->name = dev_name(dev);
+	link->playback_only = 1;
+
+	return link;
+}
+
+static int anyka_dac_create_card(struct anyka_dac *dac)
+{
+	struct device *dev = dac->dev;
+	struct snd_soc_aux_dev *aux;
+	struct snd_soc_card *card;
+	int ret;
+
+	card = devm_kzalloc(dev, sizeof(*card), GFP_KERNEL);
+	if (!card)
+		return -ENOMEM;
+
+	card->dai_link = anyka_dac_create_link(dev);
+	if (!card->dai_link)
+		return -ENOMEM;
+
+	card->dev = dev;
+	card->owner = THIS_MODULE;
+	card->name = "anyka-dac";
+	card->num_links = 1;
+	card->fully_routed = true;
+
+	aux = devm_kzalloc(dev, sizeof(*aux), GFP_KERNEL);
+	if (!aux)
+		return -ENOMEM;
+
+	aux->dlc.of_node = of_parse_phandle(dev->of_node, "anyka,amplifier", 0);
+	if (aux->dlc.of_node) {
+		card->aux_dev = aux;
+		card->num_aux_devs = 1;
+	}
+
+	ret = snd_soc_of_parse_card_name(card, "anyka,model");
+	if (ret)
+		return ret;
+
+	ret = snd_soc_of_parse_audio_simple_widgets(card, "anyka,widgets");
+	if (ret)
+		return ret;
+
+	ret = snd_soc_of_parse_audio_routing(card, "anyka,audio-routing");
+	if (ret)
+		return ret;
+
+	snd_soc_card_set_drvdata(card, dac);
+
+	return devm_snd_soc_register_card(dev, card);
+}
+
+static int anyka_dac_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct anyka_dac *dac;
+	int irq, ret;
+
+	dac = devm_kzalloc(dev, sizeof(*dac), GFP_KERNEL);
+	if (!dac)
+		return -ENOMEM;
+
+	dac->dev = dev;
+	spin_lock_init(&dac->lock);
+
+	dac->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(dac->base))
+		return PTR_ERR(dac->base);
+
+	dac->sysctrl = syscon_regmap_lookup_by_phandle(dev->of_node, "syscon");
+	if (IS_ERR(dac->sysctrl))
+		return dev_err_probe(dev, PTR_ERR(dac->sysctrl),
+				     "no system controller\n");
+
+	dac->l2 = syscon_regmap_lookup_by_phandle(dev->of_node,
+						  "anyka,l2-syscon");
+	if (IS_ERR(dac->l2))
+		return dev_err_probe(dev, PTR_ERR(dac->l2),
+				     "no L2 controller\n");
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	ret = devm_request_irq(dev, irq, anyka_dac_l2_irq, IRQF_SHARED,
+			       dev_name(dev), dac);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot claim the L2 interrupt\n");
+
+	ret = devm_snd_soc_register_component(dev, &anyka_dac_component,
+					      &anyka_dac_dai, 1);
+	if (ret)
+		return ret;
+
+	return anyka_dac_create_card(dac);
+}
