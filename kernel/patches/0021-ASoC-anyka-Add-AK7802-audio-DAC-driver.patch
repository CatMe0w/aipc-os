diff --git a/sound/soc/anyka/anyka-dac.c b/sound/soc/anyka/anyka-dac.c
new file mode 100644
index 000000000..8b60c7925
--- /dev/null
+++ b/sound/soc/anyka/anyka-dac.c
@@ -0,0 +1,762 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Anyka AK7802 audio DAC driver.
+ *
+ * Copyright (C) 2026 CatMe0w
+ * Based on vendor kernel code provided by:
+ * Copyright (C) 2001-2010 ANYKA LTD.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#define ANYKA_DAC_CONFIG		0x00
+#define ANYKA_DAC_CONFIG_ENABLE		BIT(0)
+#define ANYKA_DAC_CONFIG_L2		BIT(1)
+#define ANYKA_DAC_CONFIG_MUTE		BIT(2)
+#define ANYKA_DAC_CONFIG_ARM_IRQ	BIT(3)
+#define ANYKA_DAC_I2S_CONFIG		0x04
+#define ANYKA_DAC_I2S_WORD_LENGTH	GENMASK(4, 0)
+#define ANYKA_DAC_I2S_LEFT_HIGH		BIT(5)
+
+#define ANYKA_DAC_SAMPLE_BITS		16
+
+#define ANYKA_SYSCTRL_CLKDIV1		0x04
+#define ANYKA_CLKDIV1_PLL1_MULTIPLIER	GENMASK(5, 0)
+#define ANYKA_CLKDIV1_PLL1_DIVIDER	GENMASK(20, 17)
+#define ANYKA_SYSCTRL_CLKDIV2		0x08
+#define ANYKA_CLKDIV2_DAC_DIVIDER	GENMASK(20, 13)
+#define ANYKA_CLKDIV2_DAC_CLOCK		BIT(21)
+#define ANYKA_CLKDIV2_DAC_RESET		BIT(24)
+#define ANYKA_CLKDIV2_DAC_CLOCK_GATE	BIT(26)
+#define ANYKA_CLKDIV2_DAC_DATA_CPU	BIT(30)
+#define ANYKA_SYSCTRL_CLOCK_GATE	0x0c
+#define ANYKA_CLOCK_GATE_DAC		BIT(1)
+#define ANYKA_CLOCK_GATE_L2		BIT(3)
+#define ANYKA_CLOCK_GATE_DAC_RESET	BIT(17)
+#define ANYKA_SYSCTRL_MULTIFUNC		0x58
+#define ANYKA_MULTIFUNC_INTERNAL_DAC	BIT(23)
+#define ANYKA_SYSCTRL_ANALOG1		0x5c
+#define ANYKA_ANALOG1_PD_REFERENCE	BIT(0)
+#define ANYKA_ANALOG1_PD_ICCORE		BIT(13)
+#define ANYKA_ANALOG1_PD_I2V		BIT(14)
+#define ANYKA_ANALOG1_PD_D2S		BIT(15)
+#define ANYKA_ANALOG1_HP_INPUT		GENMASK(18, 16)
+#define ANYKA_ANALOG1_HP_INPUT_DAC	1
+#define ANYKA_ANALOG1_PD_HP		BIT(19)
+#define ANYKA_ANALOG1_QUIET_START	BIT(20)
+#define ANYKA_ANALOG1_PD_VCM		BIT(24)
+#define ANYKA_SYSCTRL_ANALOG2		0x64
+#define ANYKA_ANALOG2_DAC_ENABLE	BIT(13)
+#define ANYKA_ANALOG2_OSR		GENMASK(16, 14)
+
+#define ANYKA_L2_BUFFER_ID		3
+#define ANYKA_L2_DMA_ADDRESS		(ANYKA_L2_BUFFER_ID * sizeof(u32))
+#define ANYKA_L2_DMA_COUNT		(0x40 + ANYKA_L2_BUFFER_ID * sizeof(u32))
+#define ANYKA_L2_DMAREQ			0x80
+#define ANYKA_L2_CONF1			0x88
+#define ANYKA_L2_ASSIGN1		0x90
+#define ANYKA_L2_BUFINTEN		0x9c
+#define ANYKA_L2_DMAREQ_ENABLE		BIT(0)
+#define ANYKA_L2_FRACTION_REQUEST	BIT(9)
+#define ANYKA_L2_DAC_ASSIGN		GENMASK(29, 27)
+#define ANYKA_L2_BUFFER_REQUEST		BIT(24 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_DMA_VALID	BIT(ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_FROM_MEMORY	BIT(8 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_VALID		BIT(16 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_CLEAR		BIT(24 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_BUFFER_INTEN		BIT(9 + ANYKA_L2_BUFFER_ID)
+#define ANYKA_L2_DMA_GRANULARITY	64
+
+#define ANYKA_DAC_MAX_MASTER_CLOCK	14000000
+#define ANYKA_DAC_RATE_TOLERANCE	5
+#define ANYKA_DAC_MAX_DIVIDER		256
+#define ANYKA_DAC_PERIOD_BYTES_MIN	1024
+#define ANYKA_DAC_PERIOD_BYTES_MAX	SZ_8K
+#define ANYKA_DAC_BUFFER_BYTES_MAX	SZ_64K
+
+static const unsigned int anyka_dac_osr[] = {
+	256, 272, 264, 248, 240, 136, 128, 120,
+};
+
+/* The members of SNDRV_PCM_RATE_8000_48000, in the same order. */
+static const unsigned int anyka_dac_rates[] = {
+	8000, 11025, 16000, 22050, 32000, 44100, 48000,
+};
+
+struct anyka_dac {
+	struct device *dev;
+	void __iomem *base;
+	struct regmap *sysctrl;
+	struct regmap *l2;
+	struct snd_pcm_substream *substream;
+	spinlock_t lock;
+	unsigned int rate;
+	unsigned int rate_list[ARRAY_SIZE(anyka_dac_rates)];
+	unsigned int rate_count;
+	struct snd_pcm_hw_constraint_list rate_constraint;
+	unsigned int period_bytes;
+	unsigned int buffer_bytes;
+	unsigned int position;
+	bool running;
+};
+
+/* Card registration takes the drvdata of the device, the component does not. */
+static struct anyka_dac *anyka_dac_from_card(struct snd_soc_card *card)
+{
+	return snd_soc_card_get_drvdata(card);
+}
+
+static void anyka_dac_update(struct anyka_dac *dac, u32 reg, u32 mask, u32 set)
+{
+	u32 value = readl(dac->base + reg);
+
+	writel((value & ~mask) | set, dac->base + reg);
+}
+
+static unsigned long anyka_dac_pll1_rate(struct anyka_dac *dac)
+{
+	unsigned long rate;
+	u32 clkdiv1;
+
+	if (regmap_read(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV1, &clkdiv1))
+		return 0;
+
+	rate = 4000000UL * (62 + FIELD_GET(ANYKA_CLKDIV1_PLL1_MULTIPLIER, clkdiv1));
+	return rate / (1 + FIELD_GET(ANYKA_CLKDIV1_PLL1_DIVIDER, clkdiv1));
+}
+
+static int anyka_dac_find_divider(struct anyka_dac *dac, unsigned int rate,
+				  unsigned int *out_osr, unsigned int *out_div)
+{
+	unsigned long pll1 = anyka_dac_pll1_rate(dac);
+	unsigned int best_error = UINT_MAX;
+	unsigned int best_osr = 0;
+	unsigned int div_min;
+	unsigned int i, n;
+
+	if (!pll1 || !rate)
+		return -EINVAL;
+
+	div_min = DIV_ROUND_UP(pll1, ANYKA_DAC_MAX_MASTER_CLOCK);
+
+	for (i = 0; i < ARRAY_SIZE(anyka_dac_osr); i++) {
+		unsigned int osr = anyka_dac_osr[i];
+		unsigned int start = pll1 / (rate * osr);
+
+		/* Both neighbours. The rate is not linear in the divider. */
+		for (n = 0; n < 2; n++) {
+			unsigned int divider, got, error;
+
+			divider = clamp_t(unsigned int, start + n, div_min,
+					  ANYKA_DAC_MAX_DIVIDER);
+			got = pll1 / (divider * osr);
+			error = abs_diff(got, rate);
+
+			if (error > best_error)
+				continue;
+			/* A tie goes to the wider ratio. */
+			if (error == best_error && osr <= best_osr)
+				continue;
+
+			best_error = error;
+			best_osr = osr;
+			*out_osr = i;
+			*out_div = divider;
+		}
+	}
+
+	if (best_error == UINT_MAX)
+		return -EINVAL;
+
+	if (best_error * 1000 > rate * ANYKA_DAC_RATE_TOLERANCE)
+		return -EINVAL;
+
+	return 0;
+}
+
+static int anyka_dac_set_rate(struct anyka_dac *dac, unsigned int rate)
+{
+	unsigned int osr, divider;
+	int ret;
+
+	ret = anyka_dac_find_divider(dac, rate, &osr, &divider);
+	if (ret)
+		return ret;
+
+	regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+			   ANYKA_CLKDIV2_DAC_RESET, 0);
+	usleep_range(5000, 6000);
+	regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG2,
+			   ANYKA_ANALOG2_OSR,
+			   FIELD_PREP(ANYKA_ANALOG2_OSR, osr));
+	regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+			   ANYKA_CLKDIV2_DAC_DIVIDER,
+			   FIELD_PREP(ANYKA_CLKDIV2_DAC_DIVIDER, divider - 1));
+	usleep_range(2000, 3000);
+	regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+			   ANYKA_CLKDIV2_DAC_RESET, ANYKA_CLKDIV2_DAC_RESET);
+
+	return 0;
+}
+
+static void anyka_dac_l2_configure(struct anyka_dac *dac)
+{
+	regmap_update_bits(dac->l2, ANYKA_L2_ASSIGN1, ANYKA_L2_DAC_ASSIGN,
+			   FIELD_PREP(ANYKA_L2_DAC_ASSIGN, ANYKA_L2_BUFFER_ID));
+	regmap_update_bits(dac->l2, ANYKA_L2_DMAREQ,
+			   ANYKA_L2_FRACTION_REQUEST | ANYKA_L2_DMAREQ_ENABLE,
+			   ANYKA_L2_DMAREQ_ENABLE);
+	regmap_update_bits(dac->l2, ANYKA_L2_CONF1,
+			   ANYKA_L2_BUFFER_FROM_MEMORY |
+			   ANYKA_L2_BUFFER_DMA_VALID | ANYKA_L2_BUFFER_VALID,
+			   ANYKA_L2_BUFFER_FROM_MEMORY |
+			   ANYKA_L2_BUFFER_DMA_VALID | ANYKA_L2_BUFFER_VALID);
+	regmap_update_bits(dac->l2, ANYKA_L2_CONF1, ANYKA_L2_BUFFER_CLEAR,
+			   ANYKA_L2_BUFFER_CLEAR);
+}
+
+/* Call with the lock held. */
+static void anyka_dac_l2_start(struct anyka_dac *dac, dma_addr_t address)
+{
+	regmap_write(dac->l2, ANYKA_L2_DMA_ADDRESS, lower_32_bits(address));
+	regmap_write(dac->l2, ANYKA_L2_DMA_COUNT,
+		     dac->period_bytes / ANYKA_L2_DMA_GRANULARITY);
+	regmap_update_bits(dac->l2, ANYKA_L2_CONF1,
+			   ANYKA_L2_BUFFER_FROM_MEMORY |
+			   ANYKA_L2_BUFFER_DMA_VALID | ANYKA_L2_BUFFER_VALID,
+			   ANYKA_L2_BUFFER_FROM_MEMORY |
+			   ANYKA_L2_BUFFER_DMA_VALID | ANYKA_L2_BUFFER_VALID);
+	dma_wmb();
+	regmap_update_bits(dac->l2, ANYKA_L2_DMAREQ,
+			   ANYKA_L2_FRACTION_REQUEST | ANYKA_L2_DMAREQ_ENABLE |
+			   ANYKA_L2_BUFFER_REQUEST,
+			   ANYKA_L2_DMAREQ_ENABLE | ANYKA_L2_BUFFER_REQUEST);
+	regmap_update_bits(dac->l2, ANYKA_L2_BUFINTEN, ANYKA_L2_BUFFER_INTEN,
+			   ANYKA_L2_BUFFER_INTEN);
+}
+
+/* Call with the lock held. */
+static void anyka_dac_l2_stop(struct anyka_dac *dac)
+{
+	regmap_update_bits(dac->l2, ANYKA_L2_BUFINTEN, ANYKA_L2_BUFFER_INTEN, 0);
+	regmap_update_bits(dac->l2, ANYKA_L2_DMAREQ,
+			   ANYKA_L2_BUFFER_REQUEST | ANYKA_L2_DMAREQ_ENABLE,
+			   ANYKA_L2_DMAREQ_ENABLE);
+	regmap_write(dac->l2, ANYKA_L2_DMA_COUNT, 0);
+	regmap_update_bits(dac->l2, ANYKA_L2_CONF1, ANYKA_L2_BUFFER_CLEAR,
+			   ANYKA_L2_BUFFER_CLEAR);
+}
+
+static irqreturn_t anyka_dac_l2_irq(int irq, void *data)
+{
+	struct anyka_dac *dac = data;
+	struct snd_pcm_substream *substream;
+	unsigned long flags;
+	u32 value;
+
+	spin_lock_irqsave(&dac->lock, flags);
+	if (!dac->running) {
+		spin_unlock_irqrestore(&dac->lock, flags);
+		return IRQ_NONE;
+	}
+
+	if (regmap_read(dac->l2, ANYKA_L2_DMAREQ, &value) ||
+	    value & ANYKA_L2_BUFFER_REQUEST) {
+		spin_unlock_irqrestore(&dac->lock, flags);
+		return IRQ_NONE;
+	}
+
+	substream = dac->substream;
+	dac->position += dac->period_bytes;
+	if (dac->position >= dac->buffer_bytes)
+		dac->position = 0;
+
+	anyka_dac_l2_start(dac, substream->runtime->dma_addr + dac->position);
+	spin_unlock_irqrestore(&dac->lock, flags);
+
+	snd_pcm_period_elapsed(substream);
+
+	return IRQ_HANDLED;
+}
+
+static const struct snd_pcm_hardware anyka_dac_pcm_hardware = {
+	.info			= SNDRV_PCM_INFO_INTERLEAVED |
+				  SNDRV_PCM_INFO_BLOCK_TRANSFER |
+				  SNDRV_PCM_INFO_MMAP |
+				  SNDRV_PCM_INFO_MMAP_VALID,
+	.formats		= SNDRV_PCM_FMTBIT_S32_LE,
+	.rates			= SNDRV_PCM_RATE_8000_48000,
+	.rate_min		= 8000,
+	.rate_max		= 48000,
+	.channels_min		= 2,
+	.channels_max		= 2,
+	.buffer_bytes_max	= ANYKA_DAC_BUFFER_BYTES_MAX,
+	.period_bytes_min	= ANYKA_DAC_PERIOD_BYTES_MIN,
+	.period_bytes_max	= ANYKA_DAC_PERIOD_BYTES_MAX,
+	.periods_min		= 2,
+	.periods_max		= ANYKA_DAC_BUFFER_BYTES_MAX /
+				  ANYKA_DAC_PERIOD_BYTES_MIN,
+};
+
+static int anyka_dac_pcm_new(struct snd_soc_component *component,
+			     struct snd_soc_pcm_runtime *rtd)
+{
+	struct anyka_dac *dac = anyka_dac_from_card(rtd->card);
+
+	snd_pcm_set_managed_buffer_all(rtd->pcm, SNDRV_DMA_TYPE_DEV, dac->dev,
+				       ANYKA_DAC_BUFFER_BYTES_MAX,
+				       ANYKA_DAC_BUFFER_BYTES_MAX);
+	return 0;
+}
+
+static int anyka_dac_pcm_open(struct snd_soc_component *component,
+			      struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct anyka_dac *dac = anyka_dac_from_card(rtd->card);
+	unsigned int osr, divider, i;
+	int ret;
+
+	snd_soc_set_runtime_hwparams(substream, &anyka_dac_pcm_hardware);
+
+	/* Which rates the current PLL setting reaches is a runtime answer. */
+	dac->rate_count = 0;
+	for (i = 0; i < ARRAY_SIZE(anyka_dac_rates); i++)
+		if (!anyka_dac_find_divider(dac, anyka_dac_rates[i], &osr,
+					    &divider))
+			dac->rate_list[dac->rate_count++] = anyka_dac_rates[i];
+	if (!dac->rate_count)
+		return -EINVAL;
+
+	dac->rate_constraint.count = dac->rate_count;
+	dac->rate_constraint.list = dac->rate_list;
+	dac->rate_constraint.mask = 0;
+	ret = snd_pcm_hw_constraint_list(substream->runtime, 0,
+					 SNDRV_PCM_HW_PARAM_RATE,
+					 &dac->rate_constraint);
+	if (ret)
+		return ret;
+
+	ret = snd_pcm_hw_constraint_step(substream->runtime, 0,
+					 SNDRV_PCM_HW_PARAM_PERIOD_BYTES,
+					 ANYKA_L2_DMA_GRANULARITY);
+	if (ret)
+		return ret;
+
+	ret = snd_pcm_hw_constraint_msbits(substream->runtime, 0, 32,
+					   ANYKA_DAC_SAMPLE_BITS);
+	if (ret)
+		return ret;
+
+	return snd_pcm_hw_constraint_integer(substream->runtime,
+					     SNDRV_PCM_HW_PARAM_PERIODS);
+}
+
+static int anyka_dac_pcm_prepare(struct snd_soc_component *component,
+				 struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct anyka_dac *dac = anyka_dac_from_card(rtd->card);
+	unsigned long flags;
+	int ret;
+
+	/* A second stream finds the widgets powered and gets no power event. */
+	regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+			   ANYKA_CLOCK_GATE_DAC | ANYKA_CLOCK_GATE_L2, 0);
+	regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+			   ANYKA_CLKDIV2_DAC_CLOCK, ANYKA_CLKDIV2_DAC_CLOCK);
+	ret = anyka_dac_set_rate(dac, dac->rate);
+	if (ret)
+		return ret;
+
+	spin_lock_irqsave(&dac->lock, flags);
+	dac->substream = substream;
+	dac->period_bytes = snd_pcm_lib_period_bytes(substream);
+	dac->buffer_bytes = snd_pcm_lib_buffer_bytes(substream);
+	dac->position = 0;
+	spin_unlock_irqrestore(&dac->lock, flags);
+
+	return 0;
+}
+
+static int anyka_dac_pcm_trigger(struct snd_soc_component *component,
+				 struct snd_pcm_substream *substream, int cmd)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct anyka_dac *dac = anyka_dac_from_card(rtd->card);
+	unsigned long flags;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		anyka_dac_l2_configure(dac);
+		spin_lock_irqsave(&dac->lock, flags);
+		dac->running = true;
+		anyka_dac_l2_start(dac, substream->runtime->dma_addr +
+					dac->position);
+		spin_unlock_irqrestore(&dac->lock, flags);
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG, ANYKA_DAC_CONFIG_MUTE, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_QUIET_START, 0);
+
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG, ANYKA_DAC_CONFIG_MUTE,
+				 ANYKA_DAC_CONFIG_MUTE);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_QUIET_START,
+				   ANYKA_ANALOG1_QUIET_START);
+		spin_lock_irqsave(&dac->lock, flags);
+		dac->running = false;
+		anyka_dac_l2_stop(dac);
+		spin_unlock_irqrestore(&dac->lock, flags);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static snd_pcm_uframes_t anyka_dac_pcm_pointer(struct snd_soc_component *component,
+					       struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct anyka_dac *dac = anyka_dac_from_card(rtd->card);
+	unsigned long flags;
+	unsigned int position;
+
+	spin_lock_irqsave(&dac->lock, flags);
+	position = dac->position;
+	spin_unlock_irqrestore(&dac->lock, flags);
+
+	return bytes_to_frames(substream->runtime, position);
+}
+
+static int anyka_dac_power_event(struct snd_soc_dapm_widget *w,
+				 struct snd_kcontrol *kcontrol, int event)
+{
+	struct anyka_dac *dac = anyka_dac_from_card(snd_soc_dapm_to_card(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+				   ANYKA_CLOCK_GATE_DAC | ANYKA_CLOCK_GATE_L2, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+				   ANYKA_CLKDIV2_DAC_CLOCK |
+				   ANYKA_CLKDIV2_DAC_DATA_CPU,
+				   ANYKA_CLKDIV2_DAC_CLOCK |
+				   ANYKA_CLKDIV2_DAC_DATA_CPU);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+				   ANYKA_CLOCK_GATE_DAC_RESET,
+				   ANYKA_CLOCK_GATE_DAC_RESET);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+				   ANYKA_CLOCK_GATE_DAC_RESET, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+				   ANYKA_CLKDIV2_DAC_RESET, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+				   ANYKA_CLKDIV2_DAC_RESET,
+				   ANYKA_CLKDIV2_DAC_RESET);
+
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG, ANYKA_DAC_CONFIG_MUTE,
+				 ANYKA_DAC_CONFIG_MUTE);
+		anyka_dac_update(dac, ANYKA_DAC_I2S_CONFIG,
+				 ANYKA_DAC_I2S_WORD_LENGTH |
+				 ANYKA_DAC_I2S_LEFT_HIGH,
+				 FIELD_PREP(ANYKA_DAC_I2S_WORD_LENGTH,
+					    ANYKA_DAC_SAMPLE_BITS) |
+				 ANYKA_DAC_I2S_LEFT_HIGH);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_MULTIFUNC,
+				   ANYKA_MULTIFUNC_INTERNAL_DAC,
+				   ANYKA_MULTIFUNC_INTERNAL_DAC);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+				   ANYKA_CLKDIV2_DAC_CLOCK_GATE, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG2,
+				   ANYKA_ANALOG2_DAC_ENABLE,
+				   ANYKA_ANALOG2_DAC_ENABLE);
+
+		/* One bit per write, and the source before the enable. */
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG, ANYKA_DAC_CONFIG_L2,
+				 ANYKA_DAC_CONFIG_L2);
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG, ANYKA_DAC_CONFIG_ENABLE,
+				 ANYKA_DAC_CONFIG_ENABLE);
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG, ANYKA_DAC_CONFIG_ARM_IRQ,
+				 0);
+
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_PD_REFERENCE |
+				   ANYKA_ANALOG1_PD_VCM |
+				   ANYKA_ANALOG1_QUIET_START,
+				   ANYKA_ANALOG1_QUIET_START);
+		usleep_range(10000, 11000);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_PD_ICCORE |
+				   ANYKA_ANALOG1_PD_I2V |
+				   ANYKA_ANALOG1_PD_D2S, 0);
+		break;
+	case SND_SOC_DAPM_POST_PMD:
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_PD_ICCORE |
+				   ANYKA_ANALOG1_PD_I2V |
+				   ANYKA_ANALOG1_PD_D2S,
+				   ANYKA_ANALOG1_PD_ICCORE |
+				   ANYKA_ANALOG1_PD_I2V |
+				   ANYKA_ANALOG1_PD_D2S);
+		usleep_range(10000, 11000);
+		anyka_dac_update(dac, ANYKA_DAC_CONFIG,
+				 ANYKA_DAC_CONFIG_L2 | ANYKA_DAC_CONFIG_ENABLE |
+				 ANYKA_DAC_CONFIG_MUTE,
+				 ANYKA_DAC_CONFIG_MUTE);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG2,
+				   ANYKA_ANALOG2_DAC_ENABLE, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_MULTIFUNC,
+				   ANYKA_MULTIFUNC_INTERNAL_DAC, 0);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLKDIV2,
+				   ANYKA_CLKDIV2_DAC_CLOCK |
+				   ANYKA_CLKDIV2_DAC_CLOCK_GATE,
+				   ANYKA_CLKDIV2_DAC_CLOCK_GATE);
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_CLOCK_GATE,
+				   ANYKA_CLOCK_GATE_DAC,
+				   ANYKA_CLOCK_GATE_DAC);
+		break;
+	}
+
+	return 0;
+}
+
+static int anyka_dac_headphone_event(struct snd_soc_dapm_widget *w,
+				     struct snd_kcontrol *kcontrol, int event)
+{
+	struct anyka_dac *dac = anyka_dac_from_card(snd_soc_dapm_to_card(w->dapm));
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_PD_HP | ANYKA_ANALOG1_HP_INPUT,
+				   FIELD_PREP(ANYKA_ANALOG1_HP_INPUT,
+					      ANYKA_ANALOG1_HP_INPUT_DAC));
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		regmap_update_bits(dac->sysctrl, ANYKA_SYSCTRL_ANALOG1,
+				   ANYKA_ANALOG1_PD_HP | ANYKA_ANALOG1_HP_INPUT,
+				   ANYKA_ANALOG1_PD_HP);
+		break;
+	}
+
+	return 0;
+}
