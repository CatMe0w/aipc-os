+static const struct of_device_id anyka_dac_of_match[] = {
+	{ .compatible = "anyka,ak7802-dac" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, anyka_dac_of_match);
+
+static struct platform_driver anyka_dac_driver = {
+	.probe = anyka_dac_probe,
+	.driver = {
+		.name = "anyka-dac",
+		.of_match_table = anyka_dac_of_match,
+	},
+};
+module_platform_driver(anyka_dac_driver);
