+++ b/arch/arm/boot/dts/anyka/ak7802-netbook.dts
@@ -2,6 +2,7 @@
 /dts-v1/;
 
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
 #include "ak7802.dtsi"
 
 / {
@@ -10,6 +11,7 @@ / {
 
 	aliases {
 		display0 = &lcd0;
+		ethernet0 = &enet;
 	};
 
 	chosen {
@@ -25,6 +27,33 @@ memory@30000000 {
 		reg = <0x30000000 0x04000000>;
 	};
 
+	enet: ethernet {
+		compatible = "davicom,dm9000";
+		interrupt-parent = <&gpio>;
+		/*
+		 * INT idles low: the chip powers up active high and nothing
+		 * reprograms INTCR. The RLAN_INT# net name is misleading.
+		 */
+		interrupts = <56 IRQ_TYPE_LEVEL_HIGH>;
+
+		data-gpios = <&gpio 48 GPIO_ACTIVE_HIGH>,
+			     <&gpio 49 GPIO_ACTIVE_HIGH>,
+			     <&gpio 50 GPIO_ACTIVE_HIGH>,
+			     <&gpio 51 GPIO_ACTIVE_HIGH>,
+			     <&gpio 52 GPIO_ACTIVE_HIGH>,
+			     <&gpio 53 GPIO_ACTIVE_HIGH>,
+			     <&gpio 54 GPIO_ACTIVE_HIGH>,
+			     <&gpio 55 GPIO_ACTIVE_HIGH>;
+		cmd-gpios = <&gpio 47 GPIO_ACTIVE_HIGH>;
+		cs-gpios = <&gpio 102 GPIO_ACTIVE_LOW>;
+		ior-gpios = <&gpio 57 GPIO_ACTIVE_LOW>;
+		iow-gpios = <&gpio 58 GPIO_ACTIVE_LOW>;
+		/* LAN_RST# shares the JTAG TCK pin. */
+		reset-gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
+
+		davicom,no-eeprom;
+	};
+
 	reserved-memory {
 		#address-cells = <1>;
 		#size-cells = <1>;
diff --git a/drivers/net/ethernet/davicom/Kconfig b/drivers/net/ethernet/davicom/Kconfig
index 02e0caff9..c92f5d852 100644
--- a/drivers/net/ethernet/davicom/Kconfig
+++ b/drivers/net/ethernet/davicom/Kconfig
@@ -27,6 +27,19 @@ config DM9000
 	  To compile this driver as a module, choose M here.  The module
 	  will be called dm9000.
 
+config DM9000_GPIO_BUS
+	bool "DM9000 GPIO-driven bus support"
+	depends on DM9000=y && GPIOLIB
+	help
+	  Drive the DM9000 parallel bus from GPIOs, for boards that wire the
+	  chip up without a static memory controller. Bus cycles are generated
+	  in software, so throughput is well below a memory-mapped board.
+
+	  This is built alongside the driver rather than into it, so it
+	  requires DM9000 to be built in rather than modular.
+
+	  If unsure, say N.
+
 config DM9000_FORCE_SIMPLE_PHY_POLL
 	bool "Force simple NSR based PHY polling"
 	depends on DM9000
