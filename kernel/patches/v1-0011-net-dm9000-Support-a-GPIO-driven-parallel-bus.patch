diff --git a/drivers/net/ethernet/davicom/dm9000-gpio.c b/drivers/net/ethernet/davicom/dm9000-gpio.c
new file mode 100644
index 000000000..682b65899
--- /dev/null
+++ b/drivers/net/ethernet/davicom/dm9000-gpio.c
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * DM9000 on a GPIO-driven parallel bus.
+ *
+ * Boards with no static memory controller wire SD0..SD7, CMD, CS#, IOR# and
+ * IOW# straight to GPIOs and generate every bus cycle in software.
+ *
+ * Copyright (C) 2026 CatMe0w
+ */
+
+#include <linux/bitmap.h>
+#include <linux/gpio/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+
+#include "dm9000.h"
+
+#define DM9000_GPIO_DATA_WIDTH	8
+
+struct dm9000_gpio {
+	struct gpio_descs *data;
+	struct gpio_desc *cmd;
+	struct gpio_desc *cs;
+	struct gpio_desc *ior;
+	struct gpio_desc *iow;
+
+	/* Flipping eight descriptors is not cheap, so only do it on a change. */
+	bool data_input;
+};
+
+/* CMD selects which of the chip's two ports a data cycle reaches. */
+#define DM9000_GPIO_PORT_INDEX	0
+#define DM9000_GPIO_PORT_DATA	1
+
+static struct dm9000_gpio *to_gpio(struct board_info *db)
+{
+	return dm9000_bus_priv(db);
+}
+
+static void dm9000_gpio_dir(struct dm9000_gpio *g, bool input)
+{
+	unsigned int i;
+
+	if (g->data_input == input)
+		return;
+
+	for (i = 0; i < g->data->ndescs; i++) {
+		if (input)
+			gpiod_direction_input(g->data->desc[i]);
+		else
+			gpiod_direction_output(g->data->desc[i], 0);
+	}
+
+	g->data_input = input;
+}
+
+static void dm9000_gpio_drive(struct dm9000_gpio *g, u8 value)
+{
+	DECLARE_BITMAP(values, DM9000_GPIO_DATA_WIDTH);
+
+	values[0] = value;
+	gpiod_set_array_value(g->data->ndescs, g->data->desc,
+			      g->data->info, values);
+}
+
+static u8 dm9000_gpio_sample(struct dm9000_gpio *g)
+{
+	DECLARE_BITMAP(values, DM9000_GPIO_DATA_WIDTH) = { };
+
+	gpiod_get_array_value(g->data->ndescs, g->data->desc,
+			      g->data->info, values);
+
+	return values[0];
+}
+
+/* Open a burst on one of the two ports. Callers must pair this with _end(). */
+static void dm9000_gpio_begin(struct dm9000_gpio *g, int port, bool input)
+{
+	dm9000_gpio_dir(g, input);
+	gpiod_set_value(g->cs, 1);
+	gpiod_set_value(g->cmd, port);
+}
+
+static void dm9000_gpio_end(struct dm9000_gpio *g)
+{
+	gpiod_set_value(g->cs, 0);
+}
+
+/* The chip latches on the rising edge, so driving after the strobe is fine. */
+static void dm9000_gpio_write_cycle(struct dm9000_gpio *g, u8 value)
+{
+	gpiod_set_value(g->iow, 1);
+	dm9000_gpio_drive(g, value);
+	gpiod_set_value(g->iow, 0);
+}
+
+static u8 dm9000_gpio_read_cycle(struct dm9000_gpio *g)
+{
+	u8 value;
+
+	gpiod_set_value(g->ior, 1);
+	value = dm9000_gpio_sample(g);
+	gpiod_set_value(g->ior, 0);
+
+	return value;
+}
+
+static void dm9000_gpio_index_write(struct board_info *db, u8 reg)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_INDEX, false);
+	dm9000_gpio_write_cycle(g, reg);
+	dm9000_gpio_end(g);
+}
+
+static u8 dm9000_gpio_index_read(struct board_info *db)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+	u8 value;
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_INDEX, true);
+	value = dm9000_gpio_read_cycle(g);
+	dm9000_gpio_end(g);
+
+	return value;
+}
+
+static void dm9000_gpio_data_write(struct board_info *db, u8 value)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_DATA, false);
+	dm9000_gpio_write_cycle(g, value);
+	dm9000_gpio_end(g);
+}
+
+static u8 dm9000_gpio_data_read(struct board_info *db)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+	u8 value;
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_DATA, true);
+	value = dm9000_gpio_read_cycle(g);
+	dm9000_gpio_end(g);
+
+	return value;
+}
+
+static void dm9000_gpio_inblk(struct board_info *db, void *data, int length)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+	u8 *buf = data;
+	int i;
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_DATA, true);
+	for (i = 0; i < length; i++)
+		buf[i] = dm9000_gpio_read_cycle(g);
+	dm9000_gpio_end(g);
+}
+
+static void dm9000_gpio_outblk(struct board_info *db, const void *data,
+			       int length)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+	const u8 *buf = data;
+	int i;
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_DATA, false);
+	for (i = 0; i < length; i++)
+		dm9000_gpio_write_cycle(g, buf[i]);
+	dm9000_gpio_end(g);
+}
+
+static void dm9000_gpio_dumpblk(struct board_info *db, int length)
+{
+	struct dm9000_gpio *g = to_gpio(db);
+	int i;
+
+	dm9000_gpio_begin(g, DM9000_GPIO_PORT_DATA, true);
+	for (i = 0; i < length; i++)
+		dm9000_gpio_read_cycle(g);
+	dm9000_gpio_end(g);
+}
+
+static const struct dm9000_bus_ops dm9000_gpio_ops = {
+	.index_write	= dm9000_gpio_index_write,
+	.index_read	= dm9000_gpio_index_read,
+	.data_write	= dm9000_gpio_data_write,
+	.data_read	= dm9000_gpio_data_read,
+	.inblk		= dm9000_gpio_inblk,
+	.outblk		= dm9000_gpio_outblk,
+	.dumpblk	= dm9000_gpio_dumpblk,
+};
+
+int dm9000_gpio_bus_setup(struct board_info *db, struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct dm9000_gpio *g;
+
+	if (!device_property_present(dev, "data-gpios"))
+		return -ENODEV;
+
+	g = devm_kzalloc(dev, sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+
+	g->data = devm_gpiod_get_array(dev, "data", GPIOD_OUT_LOW);
+	if (IS_ERR(g->data))
+		return dev_err_probe(dev, PTR_ERR(g->data),
+				     "failed to get data gpios\n");
+
+	if (g->data->ndescs != DM9000_GPIO_DATA_WIDTH)
+		return dev_err_probe(dev, -EINVAL,
+				     "need %d data gpios, got %u\n",
+				     DM9000_GPIO_DATA_WIDTH, g->data->ndescs);
+
+	/* The strobes are active low; declare them that way in the DT. */
+	g->cmd = devm_gpiod_get(dev, "cmd", GPIOD_OUT_LOW);
+	if (IS_ERR(g->cmd))
+		return dev_err_probe(dev, PTR_ERR(g->cmd), "no cmd gpio\n");
+
+	g->cs = devm_gpiod_get(dev, "cs", GPIOD_OUT_LOW);
+	if (IS_ERR(g->cs))
+		return dev_err_probe(dev, PTR_ERR(g->cs), "no cs gpio\n");
+
+	g->ior = devm_gpiod_get(dev, "ior", GPIOD_OUT_LOW);
+	if (IS_ERR(g->ior))
+		return dev_err_probe(dev, PTR_ERR(g->ior), "no ior gpio\n");
+
+	g->iow = devm_gpiod_get(dev, "iow", GPIOD_OUT_LOW);
+	if (IS_ERR(g->iow))
+		return dev_err_probe(dev, PTR_ERR(g->iow), "no iow gpio\n");
+
+	dm9000_set_bus(db, &dm9000_gpio_ops, g);
+	dev_info(dev, "using GPIO-driven %d-bit bus\n", DM9000_GPIO_DATA_WIDTH);
+
+	return 0;
+}
