+struct dm9000_bus_ops {
+	void	(*index_write)(struct board_info *db, u8 reg);
+	u8	(*index_read)(struct board_info *db);	/* irq/timeout save it */
+	void	(*data_write)(struct board_info *db, u8 value);
+	u8	(*data_read)(struct board_info *db);
+	void	(*inblk)(struct board_info *db, void *data, int length);
+	void	(*outblk)(struct board_info *db, const void *data, int length);
+	void	(*dumpblk)(struct board_info *db, int length);
+	void	(*release)(struct board_info *db);
+};
