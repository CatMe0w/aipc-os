 }
 
 /*
@@ -168,8 +176,8 @@ ior(struct board_info *db, int reg)
 static void
 iow(struct board_info *db, int reg, int value)
 {
-	writeb(reg, db->io_addr);
-	writeb(value, db->io_data);
+	db->bus->index_write(db, reg);
+	db->bus->data_write(db, value);
 }
 
 static void
@@ -193,6 +201,23 @@ dm9000_reset(struct board_info *db)
 		dev_err(db->dev, "dm9000 did not respond to second reset\n");
 }
 
+/* Block helpers keep the __iomem signature because dm9000_plat_data lets a
+ * board override them.
+ */
+struct dm9000_mmio {
+	void __iomem *addr;		/* Register I/O base address */
+	void __iomem *data;		/* Data I/O address */
+
+	void (*inblk)(void __iomem *port, void *data, int length);
+	void (*outblk)(void __iomem *port, void *data, int length);
+	void (*dumpblk)(void __iomem *port, int length);
+};
+
+static struct dm9000_mmio *to_mmio(struct board_info *db)
+{
+	return db->bus_priv;
+}
+
 /* routines for sending block to chip */
 
 static void dm9000_outblk_8bit(void __iomem *reg, void *data, int count)
@@ -258,6 +283,67 @@ static void dm9000_dumpblk_32bit(void __iomem *reg, int count)
 		readl(reg);
 }
 
+static void dm9000_mmio_index_write(struct board_info *db, u8 reg)
+{
+	writeb(reg, to_mmio(db)->addr);
+}
+
+static u8 dm9000_mmio_index_read(struct board_info *db)
+{
+	return readb(to_mmio(db)->addr);
+}
+
+static void dm9000_mmio_data_write(struct board_info *db, u8 value)
+{
+	writeb(value, to_mmio(db)->data);
+}
+
+static u8 dm9000_mmio_data_read(struct board_info *db)
+{
+	return readb(to_mmio(db)->data);
+}
+
+static void dm9000_mmio_inblk(struct board_info *db, void *data, int length)
+{
+	struct dm9000_mmio *mm = to_mmio(db);
+
+	mm->inblk(mm->data, data, length);
+}
+
+static void dm9000_mmio_outblk(struct board_info *db, const void *data,
+			       int length)
+{
+	struct dm9000_mmio *mm = to_mmio(db);
+
+	mm->outblk(mm->data, (void *)data, length);
+}
+
+static void dm9000_mmio_dumpblk(struct board_info *db, int length)
+{
+	struct dm9000_mmio *mm = to_mmio(db);
+
+	mm->dumpblk(mm->data, length);
+}
+
+static void dm9000_mmio_release(struct board_info *db)
+{
+	struct dm9000_mmio *mm = to_mmio(db);
+
+	iounmap(mm->addr);
+	iounmap(mm->data);
+}
+
+static const struct dm9000_bus_ops dm9000_mmio_ops = {
+	.index_write	= dm9000_mmio_index_write,
+	.index_read	= dm9000_mmio_index_read,
+	.data_write	= dm9000_mmio_data_write,
+	.data_read	= dm9000_mmio_data_read,
+	.inblk		= dm9000_mmio_inblk,
+	.outblk		= dm9000_mmio_outblk,
+	.dumpblk	= dm9000_mmio_dumpblk,
+	.release	= dm9000_mmio_release,
+};
