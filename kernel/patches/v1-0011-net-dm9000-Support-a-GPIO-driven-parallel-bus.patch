 /*
@@ -157,8 +165,8 @@ static inline struct board_info *to_dm9000_board(struct net_device *dev)
 static u8
 ior(struct board_info *db, int reg)
 {
-	writeb(reg, db->io_addr);
-	return readb(db->io_data);
+	db->bus->index_write(db, reg);
